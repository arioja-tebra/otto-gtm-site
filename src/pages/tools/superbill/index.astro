---
import ContentDisclaimer from "../../../components/ContentDisclaimer.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import pages from "../../../data/pages.json";
---

<SiteLayout metadata={pages["/tools/superbill/"]}>
  <main id="main" class="tool-page">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>{" "}
        <a href="/tools/">Free tools</a> <span aria-hidden="true">/</span>{" "}
        <span aria-current="page">Superbill generator</span>
      </nav>
      <section class="tool-hero">
        <div class="eyebrow">Free practice tool</div>
        <h1>Superbill generator</h1>
        <p>Create an itemized document for out-of-network claims.</p>
        <a class="text-link" href="/blog/superbill-for-therapy/">
          Read the companion guide
        </a>
      </section>
      <ContentDisclaimer kind="tool" />
      <div class="tool-demo-bar">
        <button type="button" id="fill-demo" data-tool="superbill">
          Fill with demo data <span aria-hidden="true"></span>
        </button>
        <span>See a finished example in one click.</span>
        <p id="demo-status" role="status"></p>
      </div>
      <div class="tool-shell">
        <div>
          <section class="panel">
            <h2>Build your superbill</h2>
            <p class="muted">
              Fill in the details, review the preview, then download a document
              or use Print / Save as PDF.
            </p>
            <form id="form">
              <h3>Practice and clinician</h3>
              <div class="fields">
                <label>
                  Practice name *<input id="practice" required />
                </label>
                <label>
                  Clinician full name and credentials *
                  <input id="clinician" required />
                </label>
                <label>
                  Clinician NPI *
                  <input
                    id="npi"
                    required
                    inputmode="numeric"
                    pattern="[0-9]&#123;10&#125;"
                  />
                </label>
                <label>
                  Taxpayer ID / EIN *<input id="tin" required />
                </label>
                <label>
                  Practice address *<input id="address" required />
                </label>
                <label>
                  Practice phone *<input id="phone" required />
                </label>
                <label>
                  Practice email
                  <input id="email" type="email" />
                </label>
                <label>
                  License number / state
                  <input id="license" />
                </label>
              </div>
              <h3>Client and payment</h3>
              <div class="fields">
                <label>
                  Client name *<input id="client" required />
                </label>
                <label>
                  Client date of birth *<input id="dob" type="date" required />
                </label>
                <label>
                  Client address
                  <input id="clientaddress" />
                </label>
                <label>
                  Superbill date *<input id="date" type="date" required />
                </label>
                <label class="wide">
                  Diagnosis description and ICD-10-CM code *
                  <input
                    id="dx"
                    required
                    placeholder="e.g., diagnosis and code confirmed in clinical record"
                  />
                </label>
                <label>
                  Service location / POS code *
                  <input
                    id="pos"
                    required
                    placeholder="e.g., 11 - office; verify applicable code"
                  />
                </label>
                <label>
                  Amount paid ($) *
                  <input id="paid" type="number" min="0" step="0.01" required />
                </label>
                <label>
                  Payment date
                  <input id="paiddate" type="date" />
                </label>
              </div>
              <h3>Services rendered</h3>
              <div id="items"></div>
              <button type="button" class="button outline" id="addItem">
                + Add session
              </button>
              <div class="fields">
                <label class="wide">
                  Optional notes
                  <textarea
                    id="notes"
                    placeholder="Only include details needed for reimbursement"
                  ></textarea>
                </label>
              </div>
            </form>
            <div class="actions">
              <button type="button" class="button" id="download">
                Download styled document
              </button>
              <button type="button" id="print" class="button outline">
                Print / save as PDF
              </button>
            </div>
            <p id="error" class="error" role="alert"></p>
            <p class="privacy">
              Entries are not uploaded or saved by this tool. For this review
              site, use fictitious client details. Handle downloads and printed
              copies through your practice’s approved workflow.
            </p>
          </section>
        </div>
        <aside class="panel result-panel">
          <span class="pill">Out-of-network receipt</span>
          <h2 style="margin-top:15px">Pick the code that matches the care</h2>
          <p class="muted">
            Common psychotherapy codes: <b>90832</b> for 30-minute
            psychotherapy, <b>90834</b> for 45-minute psychotherapy, and{" "}
            <b>90837</b> for 60-minute psychotherapy. <b>90791</b> is a
            psychiatric diagnostic evaluation without medical services. Verify
            the billed code, time, diagnosis, place of service and payer rules
            against the clinical record before giving this to a client.
          </p>
          <div class="aside-note">
            A superbill is a receipt for a client to submit to their insurer. It
            is not a claim or a promise of reimbursement. Include only
            information the client has agreed to share.
          </div>
          <p class="muted">
            <a
              href="https://www.cms.gov/medicare-coverage-database/view/article.aspx?articleId=57520&ver=43"
              target="_blank"
              rel="noopener"
            >
              CMS psychotherapy coding guidance
            </a>
          </p>
        </aside>
      </div>
      <section class="otto-tool-hook" aria-label="Meet Otto">
        <div class="otto-hook-mark" aria-hidden="true">
          <img src="/assets/otto-logo.svg" alt="" />
          <svg viewBox="0 0 100 100">
            <path d="M50 100V25" stroke="#004852" stroke-width="2" />
            <path d="M50 75C13 73 8 43 8 33c31 1 42 20 42 42" fill="#8ca7a2" />
            <path d="M50 58c34-2 42-28 43-40-29 0-43 18-43 40" fill="#417e86" />
          </svg>
        </div>
        <div class="otto-hook-copy">
          <span class="eyebrow">Meet Otto by Tebra</span>
          <h2>Let Otto take more off your plate.</h2>
          <p>
            Otto drafts progress notes for your review and brings scheduling,
            telehealth, and payments into one place.
          </p>
          <div class="otto-hook-features">
            <span>AI-assisted notes</span>
            <span>Scheduling</span>
            <span>Payments</span>
          </div>
        </div>
        <div class="otto-hook-action">
          <a class="button light" href="/waitlist/">
            Learn more <span aria-hidden="true"></span>
          </a>
          <span>Join the Otto waitlist</span>
        </div>
      </section>
      <section class="panel preview-panel">
        <div class="document-preview-heading">
          <span class="eyebrow">Ready to keep</span>
          <h2>Review your document.</h2>
        </div>
        <p class="muted">Review the details before sharing with a client.</p>
        <div class="preview" id="preview"></div>
      </section>
    </div>
    <noscript>
      <p class="no-js wrap">
        Turn on JavaScript to calculate and generate documents. The companion
        guides remain available without JavaScript.
      </p>
    </noscript>
  </main>
  <script is:inline src="/assets/documents.js"></script>
  <script is:inline>
    const $ = (id) => document.getElementById(id),
      v = (id) => ($(id)?.value || "").trim(),
      n = (id) => Number(v(id)) || 0,
      esc = (s) =>
        String(s ?? "").replace(
          /[&<>"']/g,
          (c) =>
            ({
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              '"': "&quot;",
              "'": "&#39;",
            })[c],
        ),
      money = (x) =>
        new Intl.NumberFormat("en-US", {
          style: "currency",
          currency: "USD",
        }).format(x),
      val = (id) => esc(v(id) || "Not provided");
    let ready = false;
    function footer() {
      return '<p class="end">Built by <a href="https://otto.tebra.com/">Otto</a> · Review this document for accuracy before sharing.</p>';
    }
    function download() {
      if (!ready) {
        $("form").reportValidity();
        $("error").textContent =
          "Complete the required fields before downloading.";
        return;
      }
      OttoDocuments.download($("preview"), "superbill");
    }
    $("download").onclick = download;
    $("print").onclick = () => {
      if (!ready) {
        $("form").reportValidity();
        $("error").textContent =
          "Complete the required fields before printing.";
        return;
      }
      OttoDocuments.print($("preview"));
    };
    $("form").addEventListener("submit", (e) => e.preventDefault());
    $("form").addEventListener("input", render);
    $("form").addEventListener("change", render);
    function addItem() {
      $("items").insertAdjacentHTML(
        "beforeend",
        `<div class="repeat item"><div class="rowhead"><b>Session</b><button type="button" class="secondary remove">Remove</button></div><div class="fields"><label>Service date *<input class="item-date" type="date" required></label><label>Procedure code *<input class="item-code" required list="codes" placeholder="90834"></label><label>Service description *<input class="item-desc" required placeholder="Psychotherapy"></label><label>Charge ($) *<input class="item-price" type="number" min="0" step="0.01" required></label></div></div>`,
      );
      render();
    }
    $("form").insertAdjacentHTML(
      "beforeend",
      '<datalist id="codes"><option value="90791"><option value="90832"><option value="90834"><option value="90837"></datalist>',
    );
    $("addItem").onclick = addItem;
    $("items").addEventListener("click", (e) => {
      if (e.target.matches(".remove")) {
        e.target.closest(".item").remove();
        render();
      }
    });
    function render() {
      let i = [...document.querySelectorAll(".item")].map((el) => ({
        date: el.querySelector(".item-date").value,
        code: el.querySelector(".item-code").value,
        desc: el.querySelector(".item-desc").value,
        price: Number(el.querySelector(".item-price").value),
      }));
      let total = i.reduce((s, x) => s + x.price, 0);
      ready = $("form").checkValidity() && i.length > 0;
      n("paid") > total
        ? (($("error").textContent =
            "Amount paid exceeds listed charges. Review the entries."),
          (ready = false))
        : ($("error").textContent = "");
      $("preview").innerHTML =
        `<article class="doc"><h2 class="document-title">Superbill</h2><p>Out-of-network service receipt · Issued ${val("date")}</p><h2>Provider</h2><p><b>${val("practice")}</b> · ${val("clinician")}</p><p>${val("address")} · ${val("phone")} · ${val("email")}</p><p><b>NPI:</b> ${val("npi")} · <b>Taxpayer ID:</b> ${val("tin")} · <b>License:</b> ${val("license")}</p><h2>Client</h2><p><b>${val("client")}</b> · DOB ${val("dob")} · ${val("clientaddress")}</p><p><b>Diagnosis and ICD-10-CM code:</b> ${val("dx")} · <b>Place of service:</b> ${val("pos")}</p><h2>Services</h2><table><thead><tr><th>Date</th><th>CPT / procedure</th><th>Description</th><th>Charge</th></tr></thead><tbody>${i.map((x) => `<tr><td>${esc(x.date)}</td><td>${esc(x.code)}</td><td>${esc(x.desc)}</td><td>${money(x.price)}</td></tr>`).join("")}</tbody></table><p><b>Total charges: ${money(total)}</b></p><p><b>Amount paid: ${money(n("paid"))}</b> ${v("paiddate") ? "· Paid " + val("paiddate") : ""}</p><p><b>Remaining balance: ${money(Math.max(0, total - n("paid")))}</b></p>${v("notes") ? `<p><b>Notes:</b> ${val("notes")}</p>` : ""}<p>This receipt does not guarantee reimbursement. Client should check insurer requirements before submitting.</p>${footer()}</article>`;
    }
    addItem();
    $("date").value = new Date().toLocaleDateString("en-CA");
    render();
  </script>
  <script is:inline src="/assets/tool-demo.js" defer></script>
</SiteLayout>

<style>
  .tool-page { background: #fbf9f8; }
  .tool-page > .wrap { display: grid; grid-template-columns: minmax(0,1.16fr) minmax(0,1fr); gap: 24px; grid-template-rows: auto auto auto auto max-content 1fr auto; align-items: start; max-width: 1200px; padding: 40px clamp(20px,4vw,56px) 64px; }
  .breadcrumbs, .tool-hero, .tool-demo-bar, .otto-tool-hook { grid-column: 1 / -1; }
  .tool-page > .wrap > :global(.content-disclaimer) { grid-column: 1 / -1; grid-row: 3; margin: 0; }
  .breadcrumbs { margin: 0; font-size: 14px; }
  .breadcrumbs a { color: #004852; text-decoration: none; }
  .tool-hero { padding: 0 0 8px; }
  .tool-hero .eyebrow { display: block; font-size: 10px; font-weight: 500; letter-spacing: .12em; color: #777; }
  .tool-hero .eyebrow::before { display: none; }
  .tool-hero h1 { margin: 10px 0 18px; font-size: clamp(40px,4.4vw,60px); line-height: 1.02; font-weight: 300; letter-spacing: -1.6px; }
  .tool-hero p { margin-bottom: 18px; font-size: 20px; line-height: 28px; }
  .tool-hero .text-link { min-height: 46px; align-items: center; padding: 0 24px; background: #dc785d; border-radius: 9999px; border: 0; color: #fff; font-weight: 600; }
  .tool-hero .text-link:hover { background: #c9674e; }
  .tool-demo-bar { grid-row: 4; gap: 16px; padding: 14px 18px; margin: 0; background: rgba(65,126,134,.14); border: 0; border-radius: 16px; }
  .tool-demo-bar button { min-height: 40px; padding: 0 20px; background: #dc785d; color: #fff; border: 0; font-weight: 600; }
  .tool-demo-bar button:hover { background: #c9674e; }
  .tool-demo-bar > span { color: #545454; font-size: 14px; }
  .tool-shell { display: contents; }
  .tool-shell > div { grid-column: 1; grid-row: 5 / 7; min-width: 0; }
  .panel { padding: 32px; border: 0; border-radius: 16px; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.04),0 10px 28px -14px rgba(0,72,82,.16); }
  .panel h2 { font-size: 30px; line-height: 36px; font-weight: 300; letter-spacing: -.6px; margin: 0 0 6px; }
  .panel > .muted { font-size: 16px; line-height: 24px; margin-bottom: 24px; }
  .panel h3 { margin: 24px 0 12px; font-size: 18px; line-height: 24px; font-weight: 600; letter-spacing: 0; }
  .fields { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; }
  .tool-page :global(input), .tool-page :global(textarea) { margin-top: 6px; padding: 10px 12px; min-width: 0; border: 1px solid #d8d8d8; border-radius: 10px; font-size: 14px; line-height: 22px; }
  .tool-page :global(label) { font-size: 14px; }
  .tool-page :global(.repeat) { margin-bottom: 14px; padding: 16px; border: 1px solid #e1ded8; border-radius: 16px; background: #fff; }
  .tool-page :global(.repeat .fields) { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; }
  .tool-page :global(.rowhead) { margin-bottom: 12px; }
  .tool-page :global(.remove) { color: #004852; }
  .tool-page .button { min-height: 46px; font-size: 14px; padding: 0 22px; }
  .tool-page .button.outline { color: #195b63; border-color: #195b63; }
  #addItem { min-height: 40px; margin-bottom: 18px; padding: 0 18px; }
  .actions { margin-top: 24px; }
  .privacy { margin-bottom: 0; font-size: 12px; line-height: 20px; color: #777; }
  .result-panel { grid-column: 2; grid-row: 6; position: static; padding: 24px; }
  .result-panel h2 { font-size: 24px; line-height: 30px; }
  .result-panel .muted { font-size: 14px; line-height: 22px; margin-bottom: 12px; }
  .pill { background: rgba(65,126,134,.14); color: #004852; border: 0; font-size: 12px; }
  .aside-note { padding: 16px; background: #f0eee8; border-radius: 12px; font-size: 14px; line-height: 22px; }
  .result-panel a { color: #004852; font-weight: 600; }
  .tool-page .preview-panel { grid-column: 2; grid-row: 5; padding: 24px; margin: 0; border-radius: 20px; background: rgba(65,126,134,.14); box-shadow: none; }
  .document-preview-heading .eyebrow { color: #777; font-size: 10px; font-weight: 500; letter-spacing: .12em; }
  .document-preview-heading .eyebrow::before { display: none; }
  .document-preview-heading h2 { margin: 10px 0 4px; font-size: 26px !important; line-height: 32px; font-weight: 300; }
  .tool-page .preview-panel > .muted { font-size: 16px; line-height: 24px; margin-bottom: 18px; }
  .tool-page #preview { min-width: 0; overflow-x: auto; }
  .tool-page #preview :global(.otto-document) { width: 100%; min-width: 0; padding: 28px; border-radius: 12px; }
  .tool-page #preview :global(table) { table-layout: fixed; width: 100%; min-width: 0; }
  .tool-page #preview :global(th), .tool-page #preview :global(td) { overflow-wrap: anywhere; }
  .tool-page #preview :global(.otto-document) { border-top: 0; box-shadow: none; }
  .tool-page #preview :global(.document-brand) { border-bottom-color: #004852; }
  .tool-page #preview :global(.document-title) { font-size: 26px !important; line-height: 30px; font-weight: 300; }
  .tool-page #preview :global(.document-info-grid) { grid-template-columns: 1fr; gap: 20px; }
  .tool-page #preview :global(.document-info-grid > section) { padding: 0; border: 0; background: transparent; }
  .tool-page #preview :global(thead th) { background: transparent !important; color: #777 !important; font-size: 10px; }
  .tool-page #preview :global(.document-totals > div) { padding: 12px; background: #f0eee8; }
  .tool-page #preview :global(.document-totals strong) { font-size: 16px; font-weight: 400; }
  .otto-tool-hook { grid-row: 7; margin: 40px 0 0; }
  .otto-tool-hook { grid-template-columns: 200px minmax(0,1fr) auto; gap: 32px; padding: 32px; }
  .otto-hook-mark { height: 208px; padding: 24px; margin: -12px 0; background: #fff; border-radius: 16px; transform: rotate(-6deg); }
  .otto-hook-mark img { width: 64px; }
  .otto-hook-mark svg { right: 16px; bottom: 12px; }
  .otto-tool-hook h2 { font-size: clamp(30px,3vw,42px); font-weight: 300; letter-spacing: -1px; }
  .otto-tool-hook .eyebrow { display: block; font-size: 10px; font-weight: 500; letter-spacing: .12em; }
  .otto-tool-hook .eyebrow::before { display: none; }
  .otto-hook-features span { font-size: 14px; border-color: rgba(255,255,255,.3); }
  @media (max-width: 850px) {
    .tool-page > .wrap { grid-template-columns: minmax(0,1fr); grid-template-rows: none; padding-top: 32px; }
    .breadcrumbs { grid-row: 1; flex-wrap: wrap; margin: 0; }
    .tool-hero { grid-row: 2; margin: 0; }
    .tool-hero h1 { font-size: 40px; letter-spacing: -1.4px; }
    .tool-hero p { font-size: 18px; }
    .tool-demo-bar { grid-row: 4; margin: 0; }
    .tool-shell { display: contents; }
    .tool-shell > div { grid-column: 1; grid-row: 5; }
    .result-panel { grid-column: 1; grid-row: 7; }
    .panel { padding: 24px; }
    .tool-page .preview-panel { grid-column: 1; grid-row: 6; margin: 0; padding: 20px; }
    .tool-page #preview :global(.otto-document) { padding: 24px 16px; }
    .otto-tool-hook { grid-row: 8; grid-template-columns: 1fr; padding: 32px; gap: 20px; margin-top: 8px; }
    .otto-hook-mark { display: none; }
    .otto-hook-action { grid-column: 1; }
  }
  @media (max-width: 480px) {
    .fields, .tool-page :global(.repeat .fields) { grid-template-columns: 1fr; }
    .actions .button { width: 100%; }
    .tool-page #preview :global(table) { font-size: 11px; }
  }
</style>
