---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import pages from "../../../data/pages.json";
---

<SiteLayout metadata={pages["/tools/good-faith-estimate/"]}>
  <main id="main" class="tool-page">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>{" "}
        <a href="/tools/">Free tools</a> <span aria-hidden="true">/</span>{" "}
        <span aria-current="page">Good Faith Estimate</span>
      </nav>
      <section class="tool-hero">
        <div class="eyebrow">Free practice tool</div>
        <h1>Good Faith Estimate</h1>
        <p>Prepare a clear estimate for self-pay care.</p>
        <a class="text-link" href="/blog/good-faith-estimate-for-therapy/">
          Read the companion guide ↗
        </a>
      </section>
      <div class="tool-demo-bar">
        <button type="button" id="fill-demo" data-tool="good-faith-estimate">
          Fill with demo data <span aria-hidden="true">↗</span>
        </button>
        <span>See a finished example in one click.</span>
        <p id="demo-status" role="status"></p>
      </div>
      <div class="tool-shell">
        <div>
          <section class="panel">
            <h2>Your estimate details</h2>
            <p class="muted">
              Fill in the details, review the preview, then download a document
              or use Print / Save as PDF.
            </p>
            <form id="form">
              <h3>1. Patient and estimate</h3>
              <div class="fields">
                <label>
                  Patient full name *<input id="patient" required />
                </label>
                <label>
                  Date of birth *<input id="dob" type="date" required />
                </label>
                <label>
                  Estimate date *<input id="issued" type="date" required />
                </label>
                <label>
                  Patient email or mailing address
                  <input id="contact" />
                </label>
                <label>
                  Contact preference
                  <select id="preference">
                    <option>Not specified</option>
                    <option>Email</option>
                    <option>Mail</option>
                    <option>Phone</option>
                  </select>
                </label>
                <label>
                  Primary service requested *
                  <input
                    id="primary"
                    required
                    placeholder="Individual psychotherapy"
                  />
                </label>
                <label>
                  Diagnosis, if determined
                  <input id="diagnosis" placeholder="Description" />
                </label>
                <label>
                  Diagnosis code, if determined
                  <input id="dx" placeholder="ICD-10-CM code" />
                </label>
                <label>
                  Care starts *<input id="start" type="date" required />
                </label>
                <label>
                  Care ends *<input id="valid" type="date" required />
                  <span class="help">
                    Use the same date for a single visit. Maximum recurring
                    period: 12 months.
                  </span>
                </label>
                <input id="period" type="hidden" />
              </div>
              <h3>2. Provider</h3>
              <div class="fields">
                <label>
                  Provider / practice name *<input id="provider" required />
                </label>
                <label>
                  Provider type *
                  <input
                    id="type"
                    required
                    placeholder="Licensed clinical social worker"
                  />
                </label>
                <label>
                  Provider NPI *
                  <input
                    id="npi"
                    required
                    inputmode="numeric"
                    pattern="[0-9]&#123;10&#125;"
                  />
                </label>
                <label>
                  Taxpayer ID *
                  <input id="tin" required placeholder="TIN or EIN" />
                </label>
                <label>
                  Practice street address *<input id="address" required />
                </label>
                <label>
                  City, state and ZIP *<input id="city" required />
                </label>
                <label>
                  Contact person *<input id="person" required />
                </label>
                <label>
                  Phone *<input id="phone" required />
                </label>
                <label>
                  Email *<input id="email" type="email" required />
                </label>
                <label>
                  Location of services *
                  <input
                    id="location"
                    required
                    placeholder="Office address or telehealth"
                  />
                </label>
              </div>
              <h3>3. Expected items and charges</h3>
              <p class="muted">
                Add every item reasonably expected during this period of care.
                Enter a unit charge and expected number of units.
              </p>
              <div id="items"></div>
              <button type="button" class="button outline" id="addItem">
                + Add service
              </button>
              <h3>4. Other services and notes</h3>
              <div class="fields">
                <label class="wide">
                  Separately scheduled services, if any
                  <textarea
                    id="separate"
                    placeholder="Service and how the patient can request its separate estimate"
                  ></textarea>
                </label>
                <label class="wide">
                  Additional notes
                  <textarea
                    id="notes"
                    placeholder="Assumptions or changes that may affect the estimate"
                  ></textarea>
                </label>
              </div>
            </form>
            <div class="actions">
              <button type="button" class="button" id="download">
                Download styled document
              </button>
              <button type="button" id="print" class="button outline">
                Print / save as PDF
              </button>
            </div>
            <p id="error" class="error" role="alert"></p>
            <p class="privacy">
              Entries are not uploaded or saved by this tool. For this review
              site, use fictitious client details. Handle downloads and printed
              copies through your practice’s approved workflow.
            </p>
          </section>
        </div>
        <aside class="panel result-panel">
          <span class="pill">Single-provider draft</span>
          <h2 style="margin-top:15px">What goes in the estimate?</h2>
          <p class="muted">
            For a patient who is uninsured or not using insurance, include
            patient name and birth date, the primary service, the estimate date,
            the expected services and charges, and provider contact, NPI and
            taxpayer ID. Include diagnosis and service codes when applicable.
            Itemize expected charges for the period of care; identify any
            separately scheduled services.
          </p>
          <div class="aside-note">
            <b>Dispute threshold.</b> A patient may qualify for the federal
            patient-provider dispute process when a provider's bill is at least
            $400 above that provider's estimate. The deadline is generally 120
            calendar days from the original bill.
          </div>
          <p class="muted">
            Recurring services may be estimated for up to 12 months. CMS's
            standard form has more detail and must be checked for each
            practice's situation. This version is intended for one provider
            only. If other providers or facilities are reasonably expected to
            furnish care during the period, use the full CMS form and add their
            estimates as applicable. A generator cannot certify legal
            compliance.
          </p>
          <p class="muted">
            <a
              href="https://www.cms.gov/files/document/nsa-sample-good-faith-estimate.pdf"
              target="_blank"
              rel="noopener"
            >
              CMS sample GFE
            </a>{" "}
            ·{" "}
            <a
              href="https://www.cms.gov/files/document/good-faith-estimate-example.pdf"
              target="_blank"
              rel="noopener"
            >
              CMS model form
            </a>{" "}
            ·{" "}
            <a
              href="https://www.cms.gov/medical-bill-rights/know-your-rights/no-insurance"
              target="_blank"
              rel="noopener"
            >
              CMS patient rights
            </a>
          </p>
        </aside>
      </div>
      <section class="otto-tool-hook" aria-label="Meet Otto">
        <div class="otto-hook-mark" aria-hidden="true">
          <img src="/assets/otto-logo.svg" alt="" />
          <svg viewBox="0 0 100 100">
            <path d="M50 100V25" stroke="#004852" stroke-width="2" />
            <path d="M50 75C13 73 8 43 8 33c31 1 42 20 42 42" fill="#8ca7a2" />
            <path d="M50 58c34-2 42-28 43-40-29 0-43 18-43 40" fill="#417e86" />
          </svg>
        </div>
        <div class="otto-hook-copy">
          <span class="eyebrow">Meet Otto by Tebra</span>
          <h2>Let Otto take more off your plate.</h2>
          <p>
            Otto drafts progress notes for your review and brings scheduling,
            telehealth, and payments into one place.
          </p>
          <div class="otto-hook-features">
            <span>AI-assisted notes</span>
            <span>Scheduling</span>
            <span>Payments</span>
          </div>
        </div>
        <div class="otto-hook-action">
          <a class="button light" href="/waitlist/">
            Learn more <span aria-hidden="true">↗</span>
          </a>
          <span>Join the Otto waitlist</span>
        </div>
      </section>
      <section class="panel preview-panel">
        <div class="document-preview-heading">
          <span class="eyebrow">Ready to keep</span>
          <h2>Review your document.</h2>
        </div>
        <p class="muted">Review the details before sharing with a client.</p>
        <div class="preview" id="preview"></div>
      </section>
    </div>
    <noscript>
      <p class="no-js wrap">
        Turn on JavaScript to calculate and generate documents. The companion
        guides remain available without JavaScript.
      </p>
    </noscript>
  </main>
  <script is:inline src="/assets/documents.js"></script>
  <script is:inline>
    const $ = (id) => document.getElementById(id),
      v = (id) => ($(id)?.value || "").trim(),
      n = (id) => Number(v(id)) || 0,
      esc = (s) =>
        String(s ?? "").replace(
          /[&<>"']/g,
          (c) =>
            ({
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              '"': "&quot;",
              "'": "&#39;",
            })[c],
        ),
      money = (x) =>
        new Intl.NumberFormat("en-US", {
          style: "currency",
          currency: "USD",
        }).format(x),
      val = (id) => esc(v(id) || "Not provided");
    let ready = false;
    function footer() {
      return '<p class="end">Built by <a href="https://otto.tebra.com/">Otto</a> · Review this document for accuracy before sharing.</p>';
    }
    function download() {
      if (!ready) {
        $("form").reportValidity();
        $("error").textContent =
          "Complete the required fields before downloading.";
        return;
      }
      OttoDocuments.download($("preview"), "good-faith-estimate");
    }
    $("download").onclick = download;
    $("print").onclick = () => {
      if (!ready) {
        $("form").reportValidity();
        $("error").textContent =
          "Complete the required fields before printing.";
        return;
      }
      OttoDocuments.print($("preview"));
    };
    $("form").addEventListener("submit", (e) => e.preventDefault());
    $("form").addEventListener("input", render);
    $("form").addEventListener("change", render);
    let itemCount = 0;
    function addItem() {
      let id = itemCount++;
      $("items").insertAdjacentHTML(
        "beforeend",
        `<div class="repeat item"><div class="rowhead"><b>Expected service</b><button type="button" class="secondary remove">Remove</button></div><div class="fields"><label class="wide">Service / item *<input class="item-name" required placeholder="Individual psychotherapy"></label><label>Code type and number, if applicable<input class="item-code" placeholder="CPT 90834"></label><label>Diagnosis code, if needed<input class="item-dx" placeholder="ICD-10-CM"></label><label>Unit price ($) *<input class="item-price" required type="number" min="0" step="0.01"></label><label>Expected units *<input class="item-units" required type="number" min="1" step="1"></label></div></div>`,
      );
      render();
    }
    $("addItem").onclick = addItem;
    $("items").addEventListener("click", (e) => {
      if (e.target.matches(".remove")) {
        e.target.closest(".item").remove();
        render();
      }
    });
    function render() {
      $("period").value =
        v("start") && v("valid") ? v("start") + " to " + v("valid") : "";
      let f = $("form");
      let items = [...document.querySelectorAll(".item")].map((el) => ({
        name: el.querySelector(".item-name").value,
        code: el.querySelector(".item-code").value,
        dx: el.querySelector(".item-dx").value,
        price: Number(el.querySelector(".item-price").value),
        units: Number(el.querySelector(".item-units").value),
      }));
      let validEnd = v("valid"),
        issued = v("issued");
      let maxDate = new Date((v("start") || issued) + "T12:00:00");
      maxDate.setFullYear(maxDate.getFullYear() + 1);
      let over =
        validEnd && issued && new Date(validEnd + "T12:00:00") > maxDate;
      ready =
        f.checkValidity() &&
        items.length > 0 &&
        !over &&
        (!validEnd || validEnd >= v("start")) &&
        (!v("start") || v("start") >= issued);
      $("error").textContent = over
        ? "Recurring estimate window must be no more than 12 months from the care start date."
        : validEnd && validEnd < v("start")
          ? "Care end cannot precede care start."
          : v("start") && v("start") < issued
            ? "Care start cannot precede the estimate issue date."
            : "";
      let rows = items
        .map(
          (i) =>
            `<tr><td>${esc(i.name)}</td><td>${esc(i.code)}</td><td>${esc(i.dx || v("dx") || "Not determined")}</td><td>${i.units || "—"}</td><td>${money(i.price)}</td><td>${money(i.price * i.units)}</td></tr>`,
        )
        .join("");
      let total = items.reduce((s, i) => s + i.price * i.units, 0);
      $("preview").innerHTML =
        `<article class="doc"><h2 class="document-title">Good Faith Estimate</h2><p>For health care items and services · Date: ${val("issued")}</p><h2>Patient and care period</h2><p><b>Patient:</b> ${val("patient")} · <b>Date of birth:</b> ${val("dob")}</p><p><b>Contact:</b> ${val("contact")} · <b>Preference:</b> ${val("preference")}</p><p><b>Primary service:</b> ${val("primary")} · <b>Scheduled date(s) / period:</b> ${val("period")}</p><p><b>Diagnosis, if determined:</b> ${val("diagnosis")} · <b>Code:</b> ${val("dx")}</p>${validEnd ? `<p><b>Recurring estimate valid through:</b> ${esc(validEnd)}</p>` : ""}<h2>Provider estimate</h2><p><b>${val("provider")}</b> · ${val("type")}</p><p>${val("address")}, ${val("city")} · <b>Service location:</b> ${val("location")}</p><p><b>Contact:</b> ${val("person")} · ${val("phone")} · ${val("email")}</p><p><b>NPI:</b> ${val("npi")} · <b>Taxpayer ID:</b> ${val("tin")}</p><table><thead><tr><th>Service</th><th>Procedure code</th><th>Diagnosis code</th><th>Units</th><th>Per unit</th><th>Expected charge</th></tr></thead><tbody>${rows}</tbody></table><p><b>Provider expected charges: ${money(total)}</b></p><p><b>Total estimated cost: ${money(total)}</b></p><h2>Separately scheduled items</h2><p>${esc(v("separate") || "None identified. If services require separate scheduling, request a separate estimate from that provider.")}</p>${v("notes") ? `<p><b>Notes:</b> ${val("notes")}</p>` : ""}<h2>Important information</h2><p>This estimate shows costs reasonably expected for your care, based on information known when it was created. It does not include unknown or unexpected costs that may arise during treatment. You may be charged more if circumstances change. This is not a contract and does not require you to receive care from this provider.</p><p>If you receive a bill from this provider that is $400 or more above this provider's estimate, you may have the right to dispute it through the federal patient-provider dispute resolution process. You may contact the provider about the higher bill. To start a federal dispute, you generally must do so within 120 calendar days of the date on the original bill. Keep this estimate and the bill. Learn more at <a href="https://www.cms.gov/medical-bill-rights/help/dispute-a-bill">cms.gov/medical-bill-rights/help/dispute-a-bill</a> or call 1-800-985-3059.</p>${footer()}</article>`;
    }
    addItem();
    $("issued").value = new Date().toLocaleDateString("en-CA");
    render();
  </script>
  <script is:inline src="/assets/tool-demo.js" defer></script>
</SiteLayout>
