---
import SiteLayout from "../../layouts/SiteLayout.astro";
import pages from "../../data/pages.json";
---

<SiteLayout metadata={pages["/waitlist/"]}>
  <main id="main" class="waitlist-page">
    <div class="wrap waitlist-layout">
      <section class="waitlist-intro">
        <div class="eyebrow">Otto by Tebra</div>
        <h1>
          A little more time
          <br />
          for <em>care.</em>
        </h1>
        <p class="waitlist-dek">
          Join the waitlist for Otto, built for independent mental health
          practices.
        </p>
        <div class="waitlist-points">
          <p>
            <span>01</span> AI-assisted notes you review and sign.
          </p>
          <p>
            <span>02</span> Scheduling, telehealth, and payments together.
          </p>
          <p>
            <span>03</span> A practice day with fewer moving parts.
          </p>
        </div>
        <a class="text-link" href="/mental-health-ehr/">
          Take a closer look at Otto ↗
        </a>
        <div class="waitlist-flower" aria-hidden="true">
          <svg viewBox="0 0 300 180">
            <path d="M150 180V50" stroke="#004852" stroke-width="3" />
            <path
              d="M150 135C66 133 47 75 46 58c69-2 104 36 104 77"
              fill="#8ca7a2"
            />
            <path
              d="M150 102c78-3 107-57 108-79-64 0-108 37-108 79"
              fill="#417e86"
            />
            <circle cx="150" cy="40" r="19" fill="#b85c38" />
          </svg>
        </div>
      </section>
      <section class="waitlist-card" aria-label="Join the waitlist">
        <div class="waitlist-progress" aria-label="Signup progress">
          <span class="current" id="progress-email">
            1 <b>Your email</b>
          </span>
          <i></i>
          <span id="progress-practice">
            2 <b>Your practice</b>
          </span>
        </div>
        <div class="waitlist-demo">
          <button type="button" id="waitlist-demo-fill">
            Fill with demo data
          </button>
          <p id="waitlist-demo-status" role="status">
            Demo only. The Google Sheet-connected signup runs in the local
            version.
          </p>
          <a id="waitlist-demo-reset" href="/waitlist/" hidden>
            Restart preview
          </a>
        </div>
        <div id="email-step">
          <h2>Meet Otto.</h2>
          <p>
            Try the signup flow with fictional details. This preview does not
            collect leads.
          </p>
          <form id="waitlist-email-form">
            <label for="waitlist-email">Demo email</label>
            <input
              id="waitlist-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              maxlength="254"
              placeholder="you@yourpractice.com"
              required
            />
            <div class="bot-trap" aria-hidden="true">
              <label>
                Website
                <input
                  id="waitlist-website"
                  name="website"
                  tabindex="-1"
                  autocomplete="off"
                />
              </label>
            </div>
            <button class="button waitlist-submit" type="submit">
              Continue preview <span aria-hidden="true">↗</span>
            </button>
            <p class="waitlist-fine">
              No information is sent or saved in this GitHub Pages preview.{" "}
              <a
                href="https://www.tebra.com/platform-privacy-policy"
                target="_blank"
                rel="noopener"
              >
                Privacy policy
              </a>
            </p>
          </form>
        </div>
        <div id="practice-step" hidden>
          <div class="saved-note">
            <span aria-hidden="true">✓</span> Signup preview
          </div>
          <h2 tabindex="-1" id="practice-heading">
            A little about your practice.
          </h2>
          <p>Help us make our first conversation useful.</p>
          <form id="waitlist-practice-form">
            <div class="fields">
              <label>
                Practice size
                <select name="size" required>
                  <option value="">Select one</option>
                  <option>Solo</option>
                  <option>2–5 clinicians</option>
                  <option>6–20 clinicians</option>
                  <option>21+ clinicians</option>
                  <option>Starting a practice</option>
                </select>
              </label>
              <label>
                Specialty
                <select name="specialty" required>
                  <option value="">Select one</option>
                  <option>Therapy / counseling</option>
                  <option>Clinical social work</option>
                  <option>Psychology</option>
                  <option>Psychiatry</option>
                  <option>Psychiatric nursing</option>
                  <option>Other</option>
                </select>
              </label>
            </div>
            <fieldset class="waitlist-choice">
              <legend>How do clients pay?</legend>
              <div class="choice-row">
                <label>
                  <input
                    type="radio"
                    name="payment"
                    value="Cash pay"
                    required
                  />
                  <span>Cash pay</span>
                </label>
                <label>
                  <input type="radio" name="payment" value="Insurance" />
                  <span>Insurance</span>
                </label>
                <label>
                  <input type="radio" name="payment" value="Both" />
                  <span>Both</span>
                </label>
              </div>
            </fieldset>
            <fieldset class="waitlist-choice">
              <legend>Where are you with your EHR?</legend>
              <div class="choice-row">
                <label>
                  <input type="radio" name="ehr" value="First EHR" required />
                  <span>My first EHR</span>
                </label>
                <label>
                  <input type="radio" name="ehr" value="Switching" />
                  <span>I’m switching</span>
                </label>
              </div>
            </fieldset>
            <label id="system-field" hidden>
              Which system?
              <select name="system" disabled>
                <option value="">Select one</option>
                <option>SimplePractice</option>
                <option>TherapyNotes</option>
                <option>Sessions Health</option>
                <option>Alma</option>
                <option>Headway</option>
                <option>Tebra / Kareo</option>
                <option>Other</option>
              </select>
            </label>
            <label id="other-system-field" hidden>
              System name
              <input
                name="otherSystem"
                maxlength="80"
                disabled
                autocomplete="off"
              />
            </label>
            <button class="button waitlist-submit" type="submit">
              Finish preview <span aria-hidden="true">↗</span>
            </button>
            <button class="waitlist-skip" type="button" id="skip-practice">
              I’ll share this later
            </button>
          </form>
        </div>
        <div id="complete-step" hidden>
          <div class="success-mark" aria-hidden="true">
            ✓
          </div>
          <h2 tabindex="-1" id="complete-heading">
            Signup preview
          </h2>
          <p id="complete-copy">
            Preview complete. Nothing was submitted or saved.
          </p>
          <div class="waitlist-next">
            <span class="tag">While you’re here</span>
            <h3>Give your practice a head start.</h3>
            <p>
              Explore free tools for session rates, superbills, and good faith
              estimates.
            </p>
            <a class="text-link" href="/tools/">
              Explore the free tools ↗
            </a>
          </div>
        </div>
        <p
          id="waitlist-status"
          class="micro"
          role="status"
          aria-live="polite"
        ></p>
        <p id="waitlist-error" class="error" role="alert"></p>
        <noscript>
          <p>Enable JavaScript to try the signup preview.</p>
        </noscript>
      </section>
    </div>
  </main>
  <script is:inline src="/assets/waitlist.js" defer></script>
</SiteLayout>
