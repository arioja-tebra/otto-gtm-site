---
import SiteLayout from "../../layouts/SiteLayout.astro";
import pages from "../../data/pages.json";
---

<SiteLayout metadata={pages["/waitlist/"]}>
  <main id="main" class="waitlist-page">
    <div class="wrap waitlist-layout">
      <section class="waitlist-intro">
        <div class="eyebrow">Otto by Tebra</div>
        <h1>
          A little more time
          <br />
          for <em>care.</em>
        </h1>
        <p class="waitlist-dek">
          Explore Otto for independent mental health practices, with an early
          focus on solo, self-pay care. Try the signup preview to see the
          questions about your practice.
        </p>
        <div class="waitlist-points">
          <p>
            <span>01</span> Review and edit a SOAP or DAP draft, then sign.
          </p>
          <p>
            <span>02</span> Scheduling, telehealth, and payments together.
          </p>
          <p>
            <span>03</span> Confirm access and setup before your first session.
          </p>
        </div>
        <a class="text-link" href="/mental-health-ehr/">
          Take a closer look at Otto
        </a>
        <div class="waitlist-expectations">
          <h2>What happens next?</h2>
          <p>
            This signup is a demo. It does not reserve access, create an
            account, or send a confirmation or follow-up email.
          </p>
          <p>
            You can watch the demo and use the free tools today. Before using
            Otto with clients, confirm availability, pricing, setup, and
            support for your practice.
          </p>
          <a class="text-link" href="/faq/#getting-started">
            Access, switching, and support questions
          </a>
        </div>
        <div class="waitlist-flower" aria-hidden="true">
          <svg viewBox="0 0 300 180">
            <path d="M150 180V50" stroke="#004852" stroke-width="3" />
            <path
              d="M150 135C66 133 47 75 46 58c69-2 104 36 104 77"
              fill="#8ca7a2"
            />
            <path
              d="M150 102c78-3 107-57 108-79-64 0-108 37-108 79"
              fill="#417e86"
            />
            <circle cx="150" cy="40" r="19" fill="#b85c38" />
          </svg>
        </div>
      </section>
      <section class="waitlist-card" aria-label="Join the waitlist">
        <div class="waitlist-progress" aria-label="Signup progress">
          <span class="current" id="progress-email">
            1 <b>Your email</b>
          </span>
          <i></i>
          <span id="progress-practice">
            2 <b>Your practice</b>
          </span>
        </div>
        <div class="waitlist-demo">
          <button type="button" id="waitlist-demo-fill">
            Fill with demo data
          </button>
          <p id="waitlist-demo-status" role="status">
            Demo only. Use the fictional email provided. Nothing is submitted
            or saved.
          </p>
          <a id="waitlist-demo-reset" href="/waitlist/" hidden>
            Restart preview
          </a>
        </div>
        <div id="email-step">
          <h2>Preview the signup.</h2>
          <p>
            Try the signup flow with fictional details. This preview does not
            collect leads.
          </p>
          <form id="waitlist-email-form">
            <label for="waitlist-email">Demo email</label>
            <input
              id="waitlist-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              maxlength="254"
              placeholder="jordan@example.com"
              required
            />
            <div class="bot-trap" aria-hidden="true">
              <label>
                Website
                <input
                  id="waitlist-website"
                  name="website"
                  tabindex="-1"
                  autocomplete="off"
                />
              </label>
            </div>
            <button class="button waitlist-submit" type="submit">
              Continue preview <span aria-hidden="true"></span>
            </button>
            <p class="waitlist-fine">
              This preview does not add you to a waitlist or send an email.{" "}
              <a
                href="https://www.tebra.com/platform-privacy-policy"
                target="_blank"
                rel="noopener"
              >
                Privacy policy
              </a>
            </p>
          </form>
        </div>
        <div id="practice-step" hidden>
          <div class="saved-note">
            <span aria-hidden="true">✓</span> Signup preview
          </div>
          <h2 tabindex="-1" id="practice-heading">
            A little about your practice.
          </h2>
          <p>
            These questions help identify practice fit. Use fictional answers
            for this preview.
          </p>
          <form id="waitlist-practice-form">
            <div class="fields">
              <label>
                Practice size
                <select name="size" required>
                  <option value="">Select one</option>
                  <option>Solo</option>
                  <option>2–5 clinicians</option>
                  <option>6–20 clinicians</option>
                  <option>21+ clinicians</option>
                  <option>Starting a practice</option>
                </select>
              </label>
              <label>
                Specialty
                <select name="specialty" required>
                  <option value="">Select one</option>
                  <option>Therapy / counseling</option>
                  <option>Clinical social work</option>
                  <option>Psychology</option>
                  <option>Psychiatry</option>
                  <option>Psychiatric nursing</option>
                  <option>Other</option>
                </select>
              </label>
            </div>
            <fieldset class="waitlist-choice">
              <legend>How do clients pay?</legend>
              <div class="choice-row">
                <label>
                  <input
                    type="radio"
                    name="payment"
                    value="Cash pay"
                    required
                  />
                  <span>Cash pay</span>
                </label>
                <label>
                  <input type="radio" name="payment" value="Insurance" />
                  <span>Insurance</span>
                </label>
                <label>
                  <input type="radio" name="payment" value="Both" />
                  <span>Both</span>
                </label>
              </div>
            </fieldset>
            <fieldset class="waitlist-choice">
              <legend>Where are you with your EHR?</legend>
              <div class="choice-row">
                <label>
                  <input type="radio" name="ehr" value="First EHR" required />
                  <span>My first EHR</span>
                </label>
                <label>
                  <input type="radio" name="ehr" value="Switching" />
                  <span>I’m switching</span>
                </label>
              </div>
            </fieldset>
            <label id="system-field" hidden>
              Which system?
              <select name="system" disabled>
                <option value="">Select one</option>
                <option>SimplePractice</option>
                <option>TherapyNotes</option>
                <option>Sessions Health</option>
                <option>Alma</option>
                <option>Headway</option>
                <option>Tebra / Kareo</option>
                <option>Other</option>
              </select>
            </label>
            <label id="other-system-field" hidden>
              System name
              <input
                name="otherSystem"
                maxlength="80"
                disabled
                autocomplete="off"
              />
            </label>
            <button class="button waitlist-submit" type="submit">
              Finish preview <span aria-hidden="true"></span>
            </button>
            <button class="waitlist-skip" type="button" id="skip-practice">
              I’ll share this later
            </button>
          </form>
        </div>
        <div id="complete-step" hidden>
          <div class="success-mark" aria-hidden="true">
            ✓
          </div>
          <h2 tabindex="-1" id="complete-heading">
            Signup preview
          </h2>
          <p id="complete-copy">
            Preview complete. Nothing was submitted or saved.
          </p>
          <p>
            You will not receive an email from this preview. Explore the demo
            next, or review the questions to ask before getting started.
          </p>
          <a class="text-link" href="/demo/#watch">Watch the product demo</a>
          <div class="waitlist-next">
            <span class="tag">While you’re here</span>
            <h3>Give your practice a head start.</h3>
            <p>
              Explore free tools for session rates, superbills, and good faith
              estimates.
            </p>
            <a class="text-link" href="/tools/">
              Explore the free tools
            </a>
          </div>
        </div>
        <p
          id="waitlist-status"
          class="micro"
          role="status"
          aria-live="polite"
        ></p>
        <p id="waitlist-error" class="error" role="alert"></p>
        <noscript>
          <p>Enable JavaScript to try the signup preview.</p>
        </noscript>
      </section>
    </div>
  </main>
  <script is:inline src="/assets/waitlist.js" defer></script>
</SiteLayout>

<style>
  .waitlist-expectations { margin-top: 28px; }
  .waitlist-expectations h2 { font-size: 24px; line-height: 30px; font-weight: 400; }
  .waitlist-expectations p { font-size: 16px; line-height: 24px; }
  .waitlist-page { position: relative; isolation: isolate; min-height: 0; overflow: hidden; background: #d9cfc3; }
  .waitlist-page::before { content: ""; position: absolute; z-index: -1; inset: -60px; background: url('/media/hero-photo.png') 70% 0 / cover; filter: blur(32px); }
  .waitlist-layout { max-width: 1240px; padding: 126px 20px 72px; grid-template-columns: minmax(0,1fr) minmax(0,520px); gap: 24px; align-items: stretch; }
  .waitlist-intro { min-width: 0; padding: 40px 44px; border: 1px solid rgba(255,255,255,.85); border-radius: 20px; background: rgba(255,255,255,.78); backdrop-filter: blur(24px); }
  .waitlist-intro .eyebrow { display: block; margin-bottom: 10px; color: #545454; font-size: 10px; font-weight: 600; letter-spacing: .12em; }
  .waitlist-intro .eyebrow::before { display: none; }
  .waitlist-intro h1 { margin: 0; font-size: clamp(40px,4.4vw,60px); line-height: 1.02; font-weight: 300; letter-spacing: -1.6px; }
  .waitlist-intro h1 em { font-style: italic; color: #004852; }
  .waitlist-dek { max-width: none; margin: 22px 0 24px; font-size: 18px; line-height: 28px; }
  .waitlist-points { display: block; margin: 24px 0; }
  .waitlist-points p { font-size: 16px; line-height: 24px; gap: 12px; margin: 16px 0; }
  .waitlist-points span { color: #417e86; border-color: #d8d8d8; }
  .waitlist-intro > .text-link { display: inline-flex; min-height: 46px; padding: 0 24px; border: 0; border-radius: 9999px; background: #dc785d; color: #fff; font-weight: 600; }
  .waitlist-intro > .text-link:hover { background: #c9674e; }
  .waitlist-flower { display: block; position: relative; width: 230px; height: 160px; margin: 34px 0 0 24px; opacity: 1; }
  .waitlist-flower svg { display: none; }
  .waitlist-flower::before, .waitlist-flower::after { content: ""; position: absolute; width: 158px; height: 140px; border: 1px solid #e1ded8; border-radius: 12px; background: #fff; box-shadow: 4px 12px 24px -14px rgba(0,72,82,.3); }
  .waitlist-flower::before { left: 2px; top: 0; transform: rotate(-8deg); }
  .waitlist-flower::after { left: 52px; top: 12px; transform: rotate(6deg); background: url('/assets/otto-logo.svg') 20px 20px / 48px auto no-repeat, linear-gradient(#e8e5df,#e8e5df) 20px 65px / 114px 5px no-repeat, linear-gradient(#e8e5df,#e8e5df) 20px 82px / 94px 5px no-repeat, linear-gradient(#e8e5df,#e8e5df) 20px 99px / 74px 5px no-repeat, #fff; }
  .waitlist-card { min-width: 0; padding: 32px 36px; background: #fff; border: 0; border-radius: 16px; box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 10px 28px -14px rgba(0,72,82,.16); }
  .waitlist-progress { margin-bottom: 20px; color: #545454; }
  .waitlist-progress b { font-weight: 600; }
  .waitlist-demo { padding: 14px; background: #f0eee8; border: 0; border-radius: 14px; margin-bottom: 20px; }
  .waitlist-demo button { color: #004852; }
  .waitlist-demo p { font-size: 14px; line-height: 22px; margin: 6px 0 0; }
  .waitlist-card h2 { margin: 0 0 6px; font-size: 30px; line-height: 36px; font-weight: 300; letter-spacing: -.6px; }
  .waitlist-card > div > p { margin-bottom: 18px; font-size: 16px; line-height: 24px; }
  .waitlist-card input, .waitlist-card select { border-color: #d8d8d8; border-radius: 12px; font-size: 16px; padding: 11px 14px; }
  .waitlist-submit { min-height: 48px; margin: 12px 0 16px; justify-content: center; }
  .waitlist-submit > span:empty { display: none; }
  .waitlist-fine { color: #777; font-size: 12px !important; line-height: 20px; }
  .waitlist-fine a { color: #004852; }
  .waitlist-choice { margin-top: 20px; }
  .choice-row { flex-wrap: wrap; }
  .choice-row span { border-color: #d8d8d8; border-radius: 9999px; }
  .waitlist-skip { color: #004852; font-weight: 600; border: 0; }
  .waitlist-next { background: #f0eee8; border-radius: 16px; }
  .waitlist-next h3 { font-size: 24px; font-weight: 300; }
  .success-mark { width: 48px; height: 48px; background: #004852; color: #fff; margin-bottom: 16px; }
  @media (max-width: 1000px) {
    .waitlist-layout { grid-template-columns: 1fr; padding-top: 126px; }
    .waitlist-intro { padding: 32px; }
    .waitlist-card { width: 100%; max-width: 640px; justify-self: center; }
  }
  @media (max-width: 680px) {
    .waitlist-layout { padding-top: 126px; padding-bottom: 64px; gap: 24px; }
    .waitlist-intro { padding: 32px 28px; }
    .waitlist-intro h1 { font-size: 40px; letter-spacing: -1.4px; }
    .waitlist-dek { margin-top: 18px; }
    .waitlist-card { padding: 28px 24px; }
    .waitlist-card .fields { grid-template-columns: 1fr; }
    .waitlist-flower { width: 200px; margin-left: 0; }
  }
</style>
