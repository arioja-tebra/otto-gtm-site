---
import SiteLayout from "../../layouts/SiteLayout.astro";
import pages from "../../data/pages.json";
---

<SiteLayout metadata={pages["/mental-health-ehr/"]}>
  <main id="main" class="ed-page">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>{" "}
        <span aria-current="page">Mental health EHR</span>
      </nav>
      <section class="ed-hero">
        <div>
          <div class="eyebrow">Mental health EHR for independent practices</div>
          <h1>
            Your practice day,
            <br />
            <em>with more room for care.</em>
          </h1>
          <p class="ed-dek">
            Be ready for the conversation. Leave with the work moving forward.
            Otto connects session prep, clinical notes, patient records,
            telehealth, and payments in one mental health EHR.
          </p>
          <div class="ed-actions">
            <a class="button" href="/waitlist/">
              Join the waitlist ↗
            </a>
            <a class="text-link" href="/demo/#watch">
              Watch the 2-minute demo ↗
            </a>
          </div>
          <p class="micro">
            For independent mental health practices · Built by Tebra
          </p>
        </div>
        <div class="ed-hero-art">
          <div class="art">
            <svg
              viewBox="0 0 640 500"
              preserveAspectRatio="xMidYMid slice"
              aria-hidden="true"
            >
              <rect width="640" height="500" fill="#e0d3c8" />
              <circle cx="122" cy="116" r="160" fill="#f0eee8" />
              <path d="M0 385 640 275v225H0z" fill="#cbdde0" />
              <g transform="translate(167 96) rotate(6 150 150)">
                <rect
                  x="13"
                  y="14"
                  width="310"
                  height="285"
                  rx="15"
                  fill="#004852"
                  opacity=".12"
                />
                <rect width="310" height="285" rx="15" fill="#f6f3eb" />
                <path
                  d="M0 15a15 15 0 0 1 15-15h280a15 15 0 0 1 15 15v61H0z"
                  fill="#004852"
                />
                <path
                  d="M73-17v40m164-40v40"
                  stroke="#8ca7a2"
                  stroke-width="13"
                  stroke-linecap="round"
                />
                <g fill="#cbdde0">
                  <rect x="30" y="102" width="41" height="34" rx="5" />
                  <rect x="99" y="102" width="41" height="34" rx="5" />
                  <rect x="169" y="102" width="41" height="34" rx="5" />
                  <rect x="239" y="102" width="41" height="34" rx="5" />
                  <rect x="30" y="159" width="41" height="34" rx="5" />
                  <rect x="99" y="159" width="41" height="34" rx="5" />
                  <rect x="239" y="159" width="41" height="34" rx="5" />
                  <rect x="30" y="216" width="41" height="34" rx="5" />
                  <rect x="99" y="216" width="41" height="34" rx="5" />
                  <rect x="169" y="216" width="41" height="34" rx="5" />
                  <rect x="239" y="216" width="41" height="34" rx="5" />
                </g>
                <rect
                  x="169"
                  y="159"
                  width="41"
                  height="34"
                  rx="5"
                  fill="#b85c38"
                />
                <path
                  d="m178 175 8 8 13-17"
                  fill="none"
                  stroke="#fff"
                  stroke-width="3"
                />
              </g>
              <path
                d="m490 380 30-150"
                stroke="#b85c38"
                stroke-width="15"
                stroke-linecap="round"
              />
              <path d="m490 380-5 26 14-23" fill="#004852" />
            </svg>
          </div>
        </div>
      </section>
      <div class="ed-strip">
        <div>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            aria-hidden="true"
          >
            <rect x="4" y="5" width="16" height="16" rx="2" />
            <path d="M8 3v4m8-4v4M4 10h16m-12 5 3 3 5-5" />
          </svg>
          <div>
            <strong>Built around mental health</strong>
            <span>SOAP and DAP, with context across visits</span>
          </div>
        </div>
        <div>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            aria-hidden="true"
          >
            <rect x="5" y="3" width="14" height="18" rx="2" />
            <path d="M8 7h8M8 11h2m4 0h2M8 15h2m4 0h2M8 18h2m4 0h2" />
          </svg>
          <div>
            <strong>From preparation to payment</strong>
            <span>One connected visit workflow</span>
          </div>
        </div>
        <div>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            aria-hidden="true"
          >
            <path d="M6 3h9l4 4v14l-3-2-4 2-3-2-3 2V3Z" />
            <path d="M9 8h5M9 12h7M9 16h5" />
          </svg>
          <div>
            <strong>Your clinical judgment stays central</strong>
            <span>Review the draft. Approve chart changes.</span>
          </div>
        </div>
      </div>
      <section class="ed-section" id="connected-visit">
        <div class="ed-section-head">
          <div>
            <span class="eyebrow">The work around every session</span>
            <h2>An EHR should help you finish the visit.</h2>
          </div>
          <p>
            The conversation creates a note. The signed note informs the chart.
            The updated record prepares you for next time. Otto connects those
            steps so you can keep the work moving.
          </p>
        </div>
        <div class="ed-steps">
          <section class="ed-step">
            <span>01 / PREPARE</span>
            <h3>Pick up the thread.</h3>
            <p>
              Open the patient summary and last-session highlights before the
              next conversation.
            </p>
            <a href="/mental-health-patient-records/">
              Explore patient records ↗
            </a>
          </section>
          <section class="ed-step">
            <span>02 / MEET</span>
            <h3>Keep the visit connected.</h3>
            <p>
              Meet in person or use integrated telehealth. With appropriate
              consent, capture session audio for the note.
            </p>
            <a href="/telehealth-for-therapists/">See telehealth ↗</a>
          </section>
          <section class="ed-step">
            <span>03 / REVIEW</span>
            <h3>Make the note yours.</h3>
            <p>
              Review the SOAP or DAP draft, edit the details, and sign. Then
              confirm which proposed updates belong in the chart.
            </p>
            <a href="/ai-progress-notes/">Explore AI notes ↗</a>
          </section>
          <section class="ed-step">
            <span>04 / CLOSE</span>
            <h3>Move through payment.</h3>
            <p>
              Check the prefilled procedure code and fee, then review the
              payment details for the visit.
            </p>
            <a href="/therapy-billing-software/">See cash-pay billing ↗</a>
          </section>
        </div>
      </section>
      <section class="ed-section ed-story">
        <div class="ed-visual">
          <div class="ed-note">
            <div class="ed-note-top">
              <img
                src="/assets/otto-logo.svg"
                alt="Otto"
                width="58"
                height="30"
              />
              <span>Draft for review</span>
            </div>
            <h3>The conversation, organized.</h3>
            <p class="micro">Fictional example · SOAP structure</p>
            <div class="ed-note-row">
              <b>S</b>
              <div>
                <strong>Subjective</strong>
                <p>
                  Client described difficulty setting boundaries around work
                  messages.
                </p>
              </div>
            </div>
            <div class="ed-note-row">
              <b>O</b>
              <div>
                <strong>Objective</strong>
                <p>
                  Client practiced a response to an after-hours request during
                  the session.
                </p>
              </div>
            </div>
            <div class="ed-note-row">
              <b>A</b>
              <div>
                <strong>Assessment</strong>
                <p>
                  Add your clinical assessment after reviewing the encounter.
                </p>
              </div>
            </div>
            <div class="ed-note-row">
              <b>P</b>
              <div>
                <strong>Plan</strong>
                <p>
                  Revisit the boundary-setting practice at the next appointment.
                </p>
              </div>
            </div>
          </div>
          <div class="ed-approval">
            <p>You review, edit, and sign the final note.</p>
            <span aria-hidden="true">✓</span>
          </div>
          <p>
            Illustrative excerpt, not a clinical record or product screenshot.
          </p>
        </div>
        <div>
          <span class="eyebrow">Useful intelligence, inside the work</span>
          <h2>
            A draft to start from.
            <br />A record you stand behind.
          </h2>
          <p>
            Otto drafts the note from session audio, then gives you room to make
            it accurate. After you sign, it proposes diagnoses, treatment-plan
            items, and medication updates for the chart.
          </p>
          <ul class="ed-checks">
            <li>Choose SOAP or DAP for the draft.</li>
            <li>Edit and sign the note yourself.</li>
            <li>Confirm or dismiss each proposed clinical update.</li>
            <li>Return to the next session with refreshed context.</li>
          </ul>
          <a class="text-link" href="/ai-progress-notes/">
            Take a closer look at documentation ↗
          </a>
        </div>
      </section>
      <section class="ed-section" id="platform">
        <div class="ed-section-head">
          <div>
            <span class="eyebrow">Your everyday practice</span>
            <h2>The pieces work better together.</h2>
          </div>
          <p>
            Explore each part of Otto, then follow it through the full visit in
            the demo.
          </p>
        </div>
        <div class="ed-feature-grid">
          <a class="ed-feature" href="/ai-progress-notes/">
            <span class="tool-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                aria-hidden="true"
              >
                <path d="M6 3h9l4 4v14l-3-2-4 2-3-2-3 2V3Z" />
                <path d="M9 8h5M9 12h7M9 16h5" />
              </svg>
            </span>
            <h3>AI progress notes</h3>
            <p>
              A SOAP or DAP draft from the conversation, with time to review,
              edit, and sign.
            </p>
            <span class="text-link">Explore AI progress notes ↗</span>
          </a>
          <a class="ed-feature" href="/mental-health-patient-records/">
            <span class="tool-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                aria-hidden="true"
              >
                <path d="M6 3h9l4 4v14l-3-2-4 2-3-2-3 2V3Z" />
                <path d="M9 8h5M9 12h7M9 16h5" />
              </svg>
            </span>
            <h3>Patient records</h3>
            <p>
              Last-session highlights and proposed chart updates keep the next
              visit connected.
            </p>
            <span class="text-link">Explore patient records ↗</span>
          </a>
          <a class="ed-feature" href="/telehealth-for-therapists/">
            <span class="tool-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                aria-hidden="true"
              >
                <rect x="4" y="5" width="16" height="16" rx="2" />
                <path d="M8 3v4m8-4v4M4 10h16m-12 5 3 3 5-5" />
              </svg>
            </span>
            <h3>Integrated telehealth</h3>
            <p>
              Meet your client inside the same workspace you use to prepare and
              document.
            </p>
            <span class="text-link">Explore integrated telehealth ↗</span>
          </a>
          <a class="ed-feature" href="/therapy-scheduling-software/">
            <span class="tool-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                aria-hidden="true"
              >
                <rect x="4" y="5" width="16" height="16" rx="2" />
                <path d="M8 3v4m8-4v4M4 10h16m-12 5 3 3 5-5" />
              </svg>
            </span>
            <h3>Practice scheduling</h3>
            <p>
              Plan recurring visits, check conflicts, and make space for time
              away.
            </p>
            <span class="text-link">Explore practice scheduling ↗</span>
          </a>
          <a class="ed-feature" href="/therapy-billing-software/">
            <span class="tool-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                aria-hidden="true"
              >
                <rect x="5" y="3" width="14" height="18" rx="2" />
                <path d="M8 7h8M8 11h2m4 0h2M8 15h2m4 0h2M8 18h2m4 0h2" />
              </svg>
            </span>
            <h3>Cash-pay billing</h3>
            <p>
              Review the prefilled code and fee, then move into payment
              collection.
            </p>
            <span class="text-link">Explore cash-pay billing ↗</span>
          </a>
          <a class="ed-feature" href="/security/">
            <span class="tool-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                aria-hidden="true"
              >
                <path d="M6 3h9l4 4v14l-3-2-4 2-3-2-3 2V3Z" />
                <path d="M9 8h5M9 12h7M9 16h5" />
              </svg>
            </span>
            <h3>Clinician control</h3>
            <p>
              Review the note and confirm the clinical information that enters
              the record.
            </p>
            <span class="text-link">Explore the workflow ↗</span>
          </a>
        </div>
      </section>
      <section class="ed-section">
        <div class="ed-choice">
          <div>
            <span class="eyebrow">Choosing your next EHR</span>
            <h2>Choose for the whole day.</h2>
            <p>
              The best mental health EHR for your practice should make the
              repeated work feel connected. Look at what happens before the
              session, after you sign, and when it is time to collect payment.
            </p>
            <p>
              That is where we focus Otto: carrying useful context and the next
              action through the visit, with you in control of the clinical
              record.
            </p>
            <a class="text-link" href="/compare/">
              Find your fit ↗
            </a>
          </div>
          <div class="ed-choice-links">
            <a href="/compare/otto-vs-simplepractice/">
              <strong>Otto vs. SimplePractice ↗</strong>
              <span>
                Compare the connected visit, documentation, and practice
                workflows.
              </span>
            </a>
            <a href="/compare/otto-vs-therapynotes/">
              <strong>Otto vs. TherapyNotes ↗</strong>
              <span>
                Consider note review, billing needs, and the total cost.
              </span>
            </a>
            <a href="/switch/">
              <strong>Bring a moving plan ↗</strong>
              <span>
                Make records, setup, and continuity part of the decision.
              </span>
            </a>
          </div>
        </div>
      </section>
      <section class="ed-section">
        <div class="ed-section-head">
          <div>
            <span class="eyebrow">For the practice you are building</span>
            <h2>Independent care deserves thoughtful software.</h2>
          </div>
          <p>
            Otto’s early experience centers on solo, self-pay mental health
            practices. Start with the work you do today, and discuss any
            additional requirements with the team.
          </p>
        </div>
        <div class="ed-facts">
          <section>
            <span class="tag">01</span>
            <h3>Starting your first practice</h3>
            <p>
              Bring your appointment pattern, preferred note format, and payment
              needs. Walk through the full visit before deciding.
            </p>
          </section>
          <section>
            <span class="tag">02</span>
            <h3>Ready for a different workflow</h3>
            <p>
              Look at the handoffs that take your attention today. Use the demo
              and switching guides to see how Otto could fit.
            </p>
          </section>
          <section>
            <span class="tag">03</span>
            <h3>Insurance or a larger team</h3>
            <p>
              Tell us about claims, prescribing, supervision, or multi-provider
              needs so we can confirm current fit and availability.
            </p>
          </section>
        </div>
      </section>
      <section class="ed-section ed-faq">
        <div>
          <span class="eyebrow">A few useful answers</span>
          <h2>Get to know the details.</h2>
        </div>
        <div class="faq-list">
          <details>
            <summary>What makes Otto different?</summary>
            <p>
              Otto connects the visit from preparation to documentation,
              approved chart updates, and cash-pay collection. The practical
              difference to evaluate is how context and the next action carry
              forward after each step.{" "}
              <a href="/demo/#watch">Watch the full workflow.</a>
            </p>
          </details>
          <details>
            <summary>Who is Otto designed for?</summary>
            <p>
              Independent mental health providers, with the early experience
              centered on solo, self-pay practices. Tell us about your
              specialty, practice size, and billing model so we can confirm fit.
            </p>
          </details>
          <details>
            <summary>Does AI make clinical decisions for me?</summary>
            <p>
              You remain responsible for clinical decisions and the record.
              Review and edit the draft, sign the final note, and confirm or
              dismiss proposed structured chart updates.
            </p>
          </details>
          <details>
            <summary>
              Does Otto support insurance billing or e-prescribing?
            </summary>
            <p>
              Confirm these requirements with the team before choosing Otto. The
              workflow described here covers cash-pay collection; it does not
              promise an insurance-claims or prescribing service.
            </p>
          </details>
          <details>
            <summary>Can I move from another EHR?</summary>
            <p>
              Use the <a href="/switch/">switching guides</a> to prepare your
              record inventory and questions. Confirm accepted imports, setup
              support, timing, and fees directly with Otto.
            </p>
          </details>
          <details>
            <summary>What does Otto cost?</summary>
            <p>
              Contact the <a href="/waitlist/">Otto team</a> for pricing and
              billing details. Current signup terms govern your account.
            </p>
          </details>
        </div>
      </section>
      <section class="ed-close">
        <div>
          <h2>See what a connected practice day can feel like.</h2>
          <p>
            Watch Otto carry a visit from preparation through documentation and
            payment. Then tell us about the way you practice.
          </p>
        </div>
        <a class="button light" href="/waitlist/">
          Join the waitlist ↗
        </a>
      </section>
      <p class="ed-source">
        Product details checked against{" "}
        <a href="https://otto.tebra.com/">Otto’s public website</a> on October
        16, 2026. Confirm availability and service terms for your practice.
        Workflow examples are illustrative and use fictional information.
      </p>
    </div>
  </main>
</SiteLayout>
