---
import SiteLayout from "../../layouts/SiteLayout.astro";
import pages from "../../data/pages.json";
---

<SiteLayout metadata={pages["/blog/"]}>
  <main id="main" class="editorial-blog">
    <div class="wrap">
      <section class="hero">
        <div class="journal-panel">
          <div class="eyebrow">The independent practice journal</div>
          <div class="hero-top">
            <h1>
              A little clarity.
              <br />
              <em>More room to practice.</em>
            </h1>
            <div class="hero-intro">
              <p>
                Practical guides and free tools for the business of caring for
                people.
              </p>
              <a class="text-link" href="#all-articles">
                Find your next read <span aria-hidden="true"></span>
              </a>
            </div>
          </div>
        </div>
      </section>
      <section class="feature" aria-label="Featured article">
        <div class="feature-copy">
          <span class="tag">Featured guide · Practice finances</span>
          <h2>How much should you charge for therapy?</h2>
          <p>
            A sustainable fee starts with your numbers. Work through the math,
            then try it with your own.
          </p>
          <div class="feature-meta">
            By Otto editorial &nbsp; · &nbsp; 6 min read
          </div>
          <a class="text-link" href="/blog/how-much-to-charge-for-therapy/">
            Read the guide <span aria-hidden="true"></span>
          </a>
        </div>
        <div class="art">
          <svg
            viewBox="0 0 640 500"
            preserveAspectRatio="xMidYMid slice"
            aria-hidden="true"
          >
            <rect
              x="80"
              y="85"
              width="480"
              height="330"
              rx="22"
              fill="#fff"
              transform="rotate(-10 320 250)"
            />
            <rect
              x="85"
              y="65"
              width="480"
              height="330"
              rx="22"
              fill="#fff"
              transform="rotate(7 320 230)"
            />
            <g
              transform="rotate(-3 320 250)"
              font-family="Source Sans 3, sans-serif"
            >
              <rect
                x="85"
                y="75"
                width="470"
                height="330"
                rx="22"
                fill="#fff"
                stroke="#e8e5df"
              />
              <path
                d="M125 190h175m-175 58h145m-145 58h185"
                stroke="#e8e5df"
                stroke-width="8"
                stroke-linecap="round"
              />
              <path
                d="M380 190h115m-115 58h76m-76 58h138"
                stroke="#b85c38"
                stroke-width="8"
                stroke-linecap="round"
              />
              <rect
                x="120"
                y="345"
                width="400"
                height="45"
                rx="12"
                fill="#f6f3eb"
              />
              <text
                x="495"
                y="374"
                text-anchor="end"
                fill="#004852"
                font-size="20"
              >
                $173.61
              </text>
            </g>
          </svg>
        </div>
      </section>
      <section class="tool-strip">
        <div class="section-head">
          <h2 class="tools-heading">A few things off your plate.</h2>
          <span class="micro">Free practice tools. No signup.</span>
        </div>
        <div class="tool-grid">
          <a class="tool-card" href="/tools/session-rate-calculator/">
            <span class="tool-icon">
              <svg viewBox="0 0 260 176" fill="none" aria-hidden="true">
                <g transform="rotate(4 130 95)">
                  <rect
                    x="50"
                    y="22"
                    width="160"
                    height="210"
                    rx="10"
                    fill="#fff"
                    stroke="#e8e5df"
                  />
                  <path
                    d="M67 78h100m-100 20h120m-120 20h95m-95 20h110"
                    stroke="#e8e5df"
                    stroke-width="4"
                    stroke-linecap="round"
                  />
                  <rect
                    x="65"
                    y="154"
                    width="130"
                    height="30"
                    rx="7"
                    fill="#f6f3eb"
                  />
                  <path
                    d="M75 168h70"
                    stroke="#417e86"
                    stroke-width="3"
                    stroke-linecap="round"
                  />
                </g>
              </svg>
            </span>
            <h3>Session rate calculator</h3>
            <p>Find a fee that supports your practice and your time.</p>
            <span class="small-link">
              Use free tool <span aria-hidden="true"></span>
            </span>
          </a>
          <a class="tool-card" href="/tools/superbill/">
            <span class="tool-icon">
              <svg viewBox="0 0 260 176" fill="none" aria-hidden="true">
                <g transform="rotate(4 130 95)">
                  <rect
                    x="50"
                    y="22"
                    width="160"
                    height="210"
                    rx="10"
                    fill="#fff"
                    stroke="#e8e5df"
                  />
                  <path
                    d="M67 78h100m-100 20h120m-120 20h95m-95 20h110"
                    stroke="#e8e5df"
                    stroke-width="4"
                    stroke-linecap="round"
                  />
                  <rect
                    x="65"
                    y="154"
                    width="130"
                    height="30"
                    rx="7"
                    fill="#f6f3eb"
                  />
                  <path
                    d="M75 168h70"
                    stroke="#417e86"
                    stroke-width="3"
                    stroke-linecap="round"
                  />
                </g>
              </svg>
            </span>
            <h3>Superbill generator</h3>
            <p>Create an itemized document for out-of-network claims.</p>
            <span class="small-link">
              Use free tool <span aria-hidden="true"></span>
            </span>
          </a>
          <a class="tool-card" href="/tools/good-faith-estimate/">
            <span class="tool-icon">
              <svg viewBox="0 0 260 176" fill="none" aria-hidden="true">
                <g transform="rotate(4 130 95)">
                  <rect
                    x="50"
                    y="22"
                    width="160"
                    height="210"
                    rx="10"
                    fill="#fff"
                    stroke="#e8e5df"
                  />
                  <path
                    d="M67 78h100m-100 20h120m-120 20h95m-95 20h110"
                    stroke="#e8e5df"
                    stroke-width="4"
                    stroke-linecap="round"
                  />
                  <rect
                    x="65"
                    y="154"
                    width="130"
                    height="30"
                    rx="7"
                    fill="#f6f3eb"
                  />
                  <path
                    d="M75 168h70"
                    stroke="#417e86"
                    stroke-width="3"
                    stroke-linecap="round"
                  />
                </g>
              </svg>
            </span>
            <h3>Good Faith Estimate</h3>
            <p>Prepare a clear estimate for self-pay care.</p>
            <span class="small-link">
              Use free tool <span aria-hidden="true"></span>
            </span>
          </a>
          <a class="tool-card" href="/tools/therapy-cost-estimator/">
            <span class="tool-icon">
              <svg viewBox="0 0 260 176" fill="none" aria-hidden="true">
                <g transform="rotate(4 130 95)">
                  <rect
                    x="50"
                    y="22"
                    width="160"
                    height="210"
                    rx="10"
                    fill="#fff"
                    stroke="#e8e5df"
                  />
                  <path
                    d="M67 78h100m-100 20h120m-120 20h95m-95 20h110"
                    stroke="#e8e5df"
                    stroke-width="4"
                    stroke-linecap="round"
                  />
                  <rect
                    x="65"
                    y="154"
                    width="130"
                    height="30"
                    rx="7"
                    fill="#f6f3eb"
                  />
                  <path
                    d="M75 168h70"
                    stroke="#417e86"
                    stroke-width="3"
                    stroke-linecap="round"
                  />
                </g>
              </svg>
            </span>
            <h3>Therapy cost estimator</h3>
            <p>Explore client costs with out-of-network benefits.</p>
            <span class="small-link">
              Use free tool <span aria-hidden="true"></span>
            </span>
          </a>
        </div>
      </section>
    </div>
    <section class="library" id="all-articles">
      <div class="wrap">
        <div class="section-head">
          <h2>Good reads for your practice.</h2>
          <p>Clear answers to the questions that come up between sessions.</p>
        </div>
        <div class="library-controls">
          <div class="filters" aria-label="Filter articles">
            <button class="filter" aria-pressed="true">
              All articles
            </button>
            <button class="filter" aria-pressed="false">
              Practice finances
            </button>
            <button class="filter" aria-pressed="false">
              Billing & paperwork
            </button>
            <button class="filter" aria-pressed="false">
              Documentation
            </button>
          </div>
          <label class="search">
            <span class="sr-only">Search articles</span>
            <input type="search" id="search" placeholder="Search the journal" />
            <span aria-hidden="true">⌕</span>
          </label>
        </div>
        <div id="result-count" class="sr-only" aria-live="polite"></div>
        <div class="article-grid">
          <article
            class="story-card"
            data-story
            data-category="Practice finances"
          >
            <a href="/blog/how-much-to-charge-for-therapy/">
              <div class="art">
                <svg
                  viewBox="0 0 640 500"
                  preserveAspectRatio="xMidYMid slice"
                  aria-hidden="true"
                >
                  <rect
                    x="80"
                    y="85"
                    width="480"
                    height="330"
                    rx="22"
                    fill="#fff"
                    transform="rotate(-10 320 250)"
                  />
                  <rect
                    x="85"
                    y="65"
                    width="480"
                    height="330"
                    rx="22"
                    fill="#fff"
                    transform="rotate(7 320 230)"
                  />
                  <g
                    transform="rotate(-3 320 250)"
                    font-family="Source Sans 3, sans-serif"
                  >
                    <rect
                      x="85"
                      y="75"
                      width="470"
                      height="330"
                      rx="22"
                      fill="#fff"
                      stroke="#e8e5df"
                    />
                    <path
                      d="M125 190h175m-175 58h145m-145 58h185"
                      stroke="#e8e5df"
                      stroke-width="8"
                      stroke-linecap="round"
                    />
                    <path
                      d="M380 190h115m-115 58h76m-76 58h138"
                      stroke="#b85c38"
                      stroke-width="8"
                      stroke-linecap="round"
                    />
                    <rect
                      x="120"
                      y="345"
                      width="400"
                      height="45"
                      rx="12"
                      fill="#f6f3eb"
                    />
                    <text
                      x="495"
                      y="374"
                      text-anchor="end"
                      fill="#004852"
                      font-size="20"
                    >
                      $173.61
                    </text>
                  </g>
                </svg>
              </div>
              <span class="tag">Practice finances</span>
              <h3>How much should you charge for therapy?</h3>
              <p>
                Build a session rate around your income, expenses, and the week
                you actually want to work.
              </p>
              <div class="card-meta">
                <span>Otto editorial</span>
                <span>6 min read </span>
              </div>
            </a>
          </article>
          <article
            class="story-card"
            data-story
            data-category="Billing & paperwork"
          >
            <a href="/blog/superbill-for-therapy/">
              <div class="art">
                <svg
                  viewBox="0 0 640 500"
                  preserveAspectRatio="xMidYMid slice"
                  aria-hidden="true"
                >
                  <g
                    transform="rotate(-3 320 250)"
                    font-family="Source Sans 3, sans-serif"
                  >
                    <rect
                      x="125"
                      y="55"
                      width="390"
                      height="460"
                      rx="22"
                      fill="#fff"
                      stroke="#e8e5df"
                    />
                    <text x="165" y="158" fill="#004852" font-size="29">
                      Superbill
                    </text>
                    <path
                      d="M165 202h295m-295 48h245m-245 48h275m-275 48h210m-210 48h280"
                      stroke="#e8e5df"
                      stroke-width="8"
                      stroke-linecap="round"
                    />
                    <g fill="#417e86">
                      <circle cx="167" cy="249" r="6" />
                      <circle cx="167" cy="297" r="6" />
                      <circle cx="167" cy="345" r="6" />
                    </g>
                  </g>
                </svg>
              </div>
              <span class="tag">Billing & paperwork</span>
              <h3>A practical guide to superbills for therapy</h3>
              <p>
                What to include, what to check, and how to help clients
                understand out-of-network reimbursement.
              </p>
              <div class="card-meta">
                <span>Otto editorial</span>
                <span>5 min read </span>
              </div>
            </a>
          </article>
          <article
            class="story-card"
            data-story
            data-category="Billing & paperwork"
          >
            <a href="/blog/good-faith-estimate-for-therapy/">
              <div class="art">
                <svg
                  viewBox="0 0 640 500"
                  preserveAspectRatio="xMidYMid slice"
                  aria-hidden="true"
                >
                  <g
                    transform="rotate(-3 320 250)"
                    font-family="Source Sans 3, sans-serif"
                  >
                    <rect
                      x="125"
                      y="55"
                      width="390"
                      height="460"
                      rx="22"
                      fill="#fff"
                      stroke="#e8e5df"
                    />
                    <path
                      d="M165 175h225m-225 58h280m-280 58h235"
                      stroke="#e8e5df"
                      stroke-width="8"
                      stroke-linecap="round"
                    />
                    <rect
                      x="160"
                      y="330"
                      width="315"
                      height="70"
                      rx="12"
                      fill="#f6f3eb"
                    />
                    <path
                      d="M180 365h180"
                      stroke="#417e86"
                      stroke-width="8"
                      stroke-linecap="round"
                    />
                  </g>
                </svg>
              </div>
              <span class="tag">Billing & paperwork</span>
              <h3>Good Faith Estimates for therapy, explained</h3>
              <p>
                Give self-pay clients a clearer picture of expected charges,
                with an itemized estimate and a repeatable workflow.
              </p>
              <div class="card-meta">
                <span>Otto editorial</span>
                <span>6 min read </span>
              </div>
            </a>
          </article>
          <article class="story-card" data-story data-category="Documentation">
            <a href="/blog/soap-vs-dap-notes/">
              <div class="art">
                <svg
                  viewBox="0 0 640 500"
                  preserveAspectRatio="xMidYMid slice"
                  aria-hidden="true"
                >
                  <g
                    transform="rotate(-3 320 250)"
                    font-family="Source Sans 3, sans-serif"
                  >
                    <rect
                      x="125"
                      y="55"
                      width="390"
                      height="460"
                      rx="22"
                      fill="#fff"
                      stroke="#e8e5df"
                    />
                    <rect
                      x="160"
                      y="135"
                      width="40"
                      height="40"
                      rx="8"
                      fill="#f6f3eb"
                    />
                    <text
                      x="180"
                      y="163"
                      text-anchor="middle"
                      fill="#417e86"
                      font-size="23"
                    >
                      S
                    </text>
                    <path
                      d="M220 150h245m-245 20h190"
                      stroke="#e8e5df"
                      stroke-width="8"
                      stroke-linecap="round"
                    />
                    <rect
                      x="160"
                      y="210"
                      width="40"
                      height="40"
                      rx="8"
                      fill="#f6f3eb"
                    />
                    <text
                      x="180"
                      y="238"
                      text-anchor="middle"
                      fill="#417e86"
                      font-size="23"
                    >
                      O
                    </text>
                    <path
                      d="M220 225h245m-245 20h190"
                      stroke="#e8e5df"
                      stroke-width="8"
                      stroke-linecap="round"
                    />
                    <rect
                      x="160"
                      y="285"
                      width="40"
                      height="40"
                      rx="8"
                      fill="#f6f3eb"
                    />
                    <text
                      x="180"
                      y="313"
                      text-anchor="middle"
                      fill="#417e86"
                      font-size="23"
                    >
                      A
                    </text>
                    <path
                      d="M220 300h245m-245 20h190"
                      stroke="#e8e5df"
                      stroke-width="8"
                      stroke-linecap="round"
                    />
                    <rect
                      x="160"
                      y="360"
                      width="40"
                      height="40"
                      rx="8"
                      fill="#f6f3eb"
                    />
                    <text
                      x="180"
                      y="388"
                      text-anchor="middle"
                      fill="#417e86"
                      font-size="23"
                    >
                      P
                    </text>
                    <path
                      d="M220 375h245m-245 20h190"
                      stroke="#e8e5df"
                      stroke-width="8"
                      stroke-linecap="round"
                    />
                  </g>
                </svg>
              </div>
              <span class="tag">Documentation</span>
              <h3>SOAP or DAP? Work through the format.</h3>
              <p>
                Compare the structures, then try a fictional example and a free
                template.
              </p>
              <div class="card-meta">
                <span>Otto editorial</span>
                <span>4 min read </span>
              </div>
            </a>
          </article>
        </div>
        <p id="empty" class="empty" hidden>
          No articles match. Try “therapy,” “superbill,” or a different
          category.
        </p>
      </div>
    </section>
    <section class="cta-section">
      <div class="wrap">
        <div class="cta">
          <div>
            <h2>Make more room for the work you love.</h2>
            <p>
              See how Otto brings notes, scheduling, telehealth, and payments
              into your practice day.
            </p>
          </div>
          <a class="button light" href="/waitlist/">
            Join the waitlist <span aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  h1,
  h2 {
    text-wrap: balance;
  }
  p {
    text-wrap: pretty;
  }
  .editorial-blog .wrap {
    max-width: 1200px;
    padding: 0 clamp(20px, 4vw, 56px);
  }
  .hero {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding: 126px max(20px, calc((100vw - 1440px) / 2 + 56px)) 56px;
    background: #d9cfc3 url("/media/hero-photo.png") 70% 0% / cover;
  }
  .journal-panel {
    max-width: 560px;
    padding: 40px 44px;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(24px);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 10px 28px -14px rgba(0, 72, 82, 0.16);
  }
  .eyebrow,
  .tag,
  .micro {
    color: var(--ink-secondary);
    font-size: 11px;
    line-height: 16px;
    font-weight: 500;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }
  .eyebrow {
    margin-bottom: 14px;
  }
  .eyebrow::before {
    display: none;
  }
  .hero-top {
    display: block;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(40px, 4.4vw, 60px);
    line-height: 1.04;
    font-weight: 300;
    letter-spacing: -1.4px;
  }
  .hero h1 em {
    color: var(--deep-teal);
    font-style: italic;
  }
  .hero-intro {
    max-width: none;
    padding: 0;
    display: block;
  }
  .hero-intro p {
    margin: 16px 0 20px;
    font-size: 18px;
    line-height: 28px;
    color: var(--ink-secondary);
  }
  .hero .text-link,
  .feature .text-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    min-height: 46px;
    padding: 0 24px;
    border-radius: 9999px;
    background: var(--attention);
    color: var(--white);
    font-size: 16px;
    font-weight: 600;
  }
  .hero .text-link:hover,
  .feature .text-link:hover {
    background: #c9674e;
  }
  .feature {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-height: 353px;
    margin-top: 64px;
    border: 0;
    border-radius: 16px;
    background: var(--white);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 10px 28px -14px rgba(0, 72, 82, 0.16);
  }
  .feature > .art {
    order: -1;
    min-height: 353px;
  }
  .feature-copy {
    justify-content: center;
    gap: 12px;
    padding: clamp(28px, 3vw, 44px);
  }
  .feature h2 {
    margin: 0;
    max-width: none;
    font-size: clamp(30px, 2.8vw, 38px);
    line-height: 1.1;
    font-weight: 300;
    letter-spacing: -0.6px;
  }
  .feature p {
    max-width: none;
    margin: 0;
    font-size: 18px;
    line-height: 27px;
    color: var(--ink-secondary);
  }
  .feature-meta {
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-secondary);
  }
  .feature .text-link {
    min-height: 44px;
    margin: 0;
  }
  .art {
    position: relative;
    overflow: hidden;
    background: #f0eee8;
  }
  .art svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .art::after {
    content: "";
    position: absolute;
    top: 23%;
    left: 20%;
    width: 48px;
    height: 24px;
    background: url("/assets/otto-logo.svg") left center / contain no-repeat;
    transform: rotate(-3deg);
  }
  .feature .art::after {
    top: 21%;
    left: 19%;
  }
  .story-card .art::after {
    top: 12%;
    left: 25%;
    width: 32px;
    height: 18px;
  }
  .tool-strip {
    padding: 64px 0;
  }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin-bottom: 24px;
  }
  .section-head h2,
  .cta h2 {
    margin: 0;
    font-size: clamp(30px, 3vw, 42px);
    line-height: 1.08;
    font-weight: 300;
    letter-spacing: -0.8px;
  }
  .tool-grid,
  .article-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .tool-card {
    padding: 0 0 24px;
    overflow: hidden;
    color: var(--ink);
  }
  .tool-icon {
    display: block;
    position: relative;
    width: 100%;
    height: 176px;
    margin: 0 0 20px;
    border: 0;
    border-radius: 0;
    overflow: hidden;
    background: #f0eee8;
  }
  .tool-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .tool-icon::after {
    content: "";
    position: absolute;
    width: 32px;
    height: 20px;
    top: 36px;
    left: calc(50% - 58px);
    background: url("/assets/otto-logo.svg") center / contain no-repeat;
    transform: rotate(4deg);
  }
  .tool-card:nth-child(even) .tool-icon svg,
  .tool-card:nth-child(even) .tool-icon::after {
    transform: rotate(-8deg);
  }
  .tool-card h3 {
    margin: 0 20px 6px;
    font-size: 22px;
    line-height: 28px;
    letter-spacing: -0.3px;
    font-weight: 300;
  }
  .tool-card p {
    margin: 0 20px 10px;
    font-size: 16px;
    line-height: 22px;
  }
  .tool-card .small-link {
