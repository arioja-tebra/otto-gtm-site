---
import SiteLayout from "../../layouts/SiteLayout.astro";
import pages from "../../data/pages.json";
---

<SiteLayout metadata={pages["/mental-health-patient-records/"]}>
  <main id="main" class="ed-page">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>{" "}
        <a href="/mental-health-ehr/">Mental health EHR</a>{" "}
        <span aria-hidden="true">/</span>{" "}
        <span aria-current="page">
          Mental Health Patient Records &amp; Session Preparation
        </span>
      </nav>
      <div class="ed-feature-hero">
        <section class="ed-hero">
          <div>
            <div class="eyebrow">Patient records and session preparation</div>
            <h1>
              Pick up where
              <br />
              <em>the conversation left off.</em>
            </h1>
            <p class="ed-dek">
              Bring last-session highlights, clinical notes, appointment
              history, and billing into view. Otto helps connect what happened
              in one visit with the preparation for the next.
            </p>
            <div class="ed-actions">
              <a class="button" href="/waitlist/">
                Join the waitlist ↗
              </a>
              <a class="text-link" href="/demo/#watch">
                Watch the 2-minute demo ↗
              </a>
            </div>
            <p class="micro">
              For independent mental health practices · Built by Tebra
            </p>
          </div>
          <div class="ed-hero-art">
            <div class="art">
              <svg
                viewBox="0 0 640 500"
                preserveAspectRatio="xMidYMid slice"
                aria-hidden="true"
              >
                <rect width="640" height="500" fill="#dce7de" />
                <circle cx="490" cy="80" r="200" fill="#c5d7ce" />
                <g transform="translate(165 55) rotate(-7 145 180)">
                  <rect
                    x="14"
                    y="16"
                    width="290"
                    height="350"
                    rx="14"
                    fill="#004852"
                    opacity=".1"
                  />
                  <rect width="290" height="350" rx="14" fill="#fffdf8" />
                  <path
                    d="M28 42h95"
                    stroke="#004852"
                    stroke-width="6"
                    stroke-linecap="round"
                  />
                  <g fill="#004852">
                    <rect x="28" y="80" width="34" height="34" rx="10" />
                    <rect x="28" y="143" width="34" height="34" rx="10" />
                    <rect x="28" y="206" width="34" height="34" rx="10" />
                    <rect x="28" y="269" width="34" height="34" rx="10" />
                  </g>
                  <g stroke="#a6bfb2" stroke-width="4" stroke-linecap="round">
                    <path d="M80 91h170m-170 15h130M80 154h170m-170 15h110M80 217h170m-170 15h145M80 280h170m-170 15h120" />
                  </g>
                  <g
                    fill="#f6f3eb"
                    font-family="sans-serif"
                    font-size="17"
                    text-anchor="middle"
                  >
                    <text x="45" y="103">
                      S
                    </text>
                    <text x="45" y="166">
                      O
                    </text>
                    <text x="45" y="229">
                      A
                    </text>
                    <text x="45" y="292">
                      P
                    </text>
                  </g>
                </g>
                <circle cx="480" cy="365" r="48" fill="#b85c38" />
                <path
                  d="m460 365 15 15 27-32"
                  fill="none"
                  stroke="#fffdf8"
                  stroke-width="4"
                  stroke-linecap="round"
                />
              </svg>
            </div>
          </div>
        </section>
      </div>
      <section class="ed-section">
        <div class="ed-section-head">
          <div>
            <span class="eyebrow">The work, connected</span>
            <h2>Build continuity across the visit.</h2>
          </div>
          <p>
            A record becomes more useful when the information you need is
            available at the moment you need it.
          </p>
        </div>
        <div class="ed-facts">
          <section>
            <span class="tag">01</span>
            <h3>Start with the context</h3>
            <p>
              Review the patient summary and last-session highlights, then
              return to the original record when you need detail.
            </p>
          </section>
          <section>
            <span class="tag">02</span>
            <h3>Keep the record coherent</h3>
            <p>
              After signing a note, review proposed diagnoses, treatment-plan
              items, and medication changes before accepting them.
            </p>
          </section>
          <section>
            <span class="tag">03</span>
            <h3>Return ready for next time</h3>
            <p>
              Otto refreshes the summary after new notes so the next visit can
              begin with the latest documented context.
            </p>
          </section>
        </div>
      </section>
      <section class="ed-section ed-story">
        <div>
          <span class="eyebrow">Inside the workflow</span>
          <h2>A patient record you can return to.</h2>
          <p>
            Patient 360 brings demographics, appointments, clinical notes, and
            billing history into one record. Search helps you get back to the
            patient and the details you need.
          </p>
          <a class="text-link" href="/demo/#watch">
            See the complete visit ↗
          </a>
        </div>
        <ul class="ed-checks">
          <li>Patient profiles and search</li>
          <li>Clinical notes and appointment history</li>
          <li>Last-session highlights and summaries</li>
          <li>Proposed clinical updates that you approve</li>
        </ul>
      </section>
      <section class="ed-section ed-faq">
        <div>
          <span class="eyebrow">A few useful answers</span>
          <h2>Get to know the details.</h2>
        </div>
        <div class="faq-list">
          <details>
            <summary>Does Otto change the chart automatically?</summary>
            <p>
              Otto proposes structured clinical updates from the signed note.
              Those changes require your confirmation before entering the
              longitudinal record.
            </p>
          </details>
          <details>
            <summary>Should I rely only on the AI summary?</summary>
            <p>
              Use the summary to orient yourself, then check relevant source
              information in the record. Clinical interpretation and decisions
              remain yours.
            </p>
          </details>
          <details>
            <summary>
              Is a proposed treatment-plan item a complete treatment plan?
            </summary>
            <p>
              A proposed chart item is part of the update workflow. Confirm
              requirements for standalone treatment-plan documents, signatures,
              and review schedules separately.
            </p>
          </details>
          <details>
            <summary>Can my historical records be imported?</summary>
            <p>
              Confirm supported record categories, file formats, and migration
              assistance with Otto. Our <a href="/switch/">switching guides</a>{" "}
              help you prepare the questions.
            </p>
          </details>
        </div>
      </section>
      <section class="ed-section">
        <span class="eyebrow">Keep exploring</span>
        <div class="ed-resources">
          <a href="/mental-health-ehr/">The mental health EHR ↗</a>
          <a href="/ai-progress-notes/">AI progress notes ↗</a>
          <a href="/compare/">Compare your options ↗</a>
          <a href="/tools/">Free practice tools ↗</a>
        </div>
      </section>
      <section class="ed-close">
        <div>
          <h2>See what a connected practice day can feel like.</h2>
          <p>
            Watch Otto carry a visit from preparation through documentation and
            payment. Then tell us about the way you practice.
          </p>
        </div>
        <a class="button light" href="/waitlist/">
          Join the waitlist ↗
        </a>
      </section>
      <p class="ed-source">
        Product details checked against{" "}
        <a href="https://otto.tebra.com/">Otto’s public website</a> on October
        16, 2026. Confirm availability and service terms for your practice.
        Workflow examples are illustrative and use fictional information.
      </p>
    </div>
  </main>
</SiteLayout>
