---
import PracticeVideos from "../../../components/PracticeVideos.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { features } from "../../../data/practice";
import pages from "../../../data/pages.json";
---

<SiteLayout metadata={pages["/your-practice/preview/"]}>
  <link rel="stylesheet" href="/assets/practice.css" />
  <main id="main" class="practice-page">
    <div class="wrap">
      <div class="practice-subnav">
        <a href="/your-practice/build/" id="edit-practice">
          ← Edit my preferences
        </a>
        <span class="concept-tag">Your Otto tour</span>
      </div>
      <section class="practice-result-intro">
        <div class="eyebrow">Your practice, with Otto</div>
        <h1>
          See Otto for <em id="result-practice-name">your practice.</em>
        </h1>
        <p>
          Explore how Otto connects the parts of your practice day you chose.
        </p>
        <div class="result-tags">
          <span id="result-size">Solo practice</span>
          <span id="result-setting">In person and online</span>
        </div>
      </section>
      <section class="result-workspace" aria-label="Your Otto product tour">
        <div class="result-sidebar">
          <img src="/assets/otto-logo.svg" alt="Otto" width="65" height="34" />
          <span class="result-sidebar-label">YOUR WORKSPACE</span>
          <b>◷ &nbsp; My day</b>
          <span>▤ &nbsp; My notes</span>
          <span>☷ &nbsp; Payments</span>
          <div class="result-sidebar-bottom">
            Made for your practice.
            <br />
            <small>Product tour preview</small>
          </div>
        </div>
        <div class="result-main">
          <div class="result-heading">
            <div>
              <span class="tag">FROM PREPARATION TO PAYMENT</span>
              <h2>More room for care.</h2>
            </div>
            <span class="concept-tag">Preview</span>
          </div>
          <p class="result-explainer">
            Here are the workflows you chose. Take a closer look or watch Otto
            in action.
          </p>
          <div class="result-feature-cards">
            {features.map((feature) => (
              <article data-result-feature={feature.slug}>
                <span class="result-card-number">
                  {feature.number} / YOUR PRACTICE
                </span>
                <h3>{feature.label}</h3>
                <p>{feature.description}</p>
                <button
                  type="button"
                  class="text-link"
                  data-interest={feature.slug}
                >
                  Take a closer look <span aria-hidden="true">↗</span>
                </button>
              </article>
            ))}
          </div>
        </div>
      </section>
      <PracticeVideos />
      <section class="result-next">
        <div>
          <h2>Ready to see more?</h2>
          <p>Choose a workflow above to preview joining the Otto waitlist.</p>
        </div>
        <a class="text-link" href="/your-practice/">
          Explore more of Otto ↗
        </a>
      </section>
      <p class="practice-disclosure">
        Product tour preview. No appointments, clinical information, or leads
        are collected.
      </p>
      <dialog id="interest-dialog" aria-labelledby="interest-title">
        <button class="dialog-close" type="button" aria-label="Close">
          ×
        </button>
        <div id="interest-form-step">
          <div class="eyebrow">Meet Otto</div>
          <h2 id="interest-title">Make more room for care.</h2>
          <p>
            <strong id="interest-feature-name">Session prep</strong> is part of
            your Otto tour. Preview joining the waitlist to learn more.
          </p>
          <form id="interest-form">
            <label for="interest-email">Demo email</label>
            <input
              type="email"
              id="interest-email"
              value="alex@example.com"
              required
              maxlength="254"
              autocomplete="off"
            />
            <button class="button" type="submit">
              Preview waitlist signup ↗
            </button>
          </form>
          <p class="practice-fine">
            Demo only. Nothing is submitted or saved, and no email will be sent.
          </p>
        </div>
        <div id="interest-complete" hidden>
          <div class="eyebrow">Preview complete</div>
          <h2 tabindex="-1" id="interest-complete-title">
            Thanks for exploring.
          </h2>
          <p>
            You’ve reached the end of the waitlist demo. Nothing was submitted
            or saved.
          </p>
          <button class="button" type="button" id="interest-return">
            Back to my practice ↗
          </button>
        </div>
      </dialog>
    </div>
  </main>
  <script is:inline defer src="/assets/practice.js"></script>
</SiteLayout>
