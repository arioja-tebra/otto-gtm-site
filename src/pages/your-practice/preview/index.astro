---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { features } from "../../../data/practice";
import pages from "../../../data/pages.json";
---

<SiteLayout metadata={pages["/your-practice/preview/"]}>
  <link rel="stylesheet" href="/assets/practice.css" />
  <main id="main" class="practice-page">
    <div class="wrap">
      <div class="practice-subnav">
        <a href="/your-practice/build/" id="edit-practice">
          ← Edit my preferences
        </a>
        <span class="concept-tag">Your personalized concept</span>
      </div>
      <section class="practice-result-intro">
        <div class="eyebrow">A little more you</div>
        <h1>
          Welcome to <em id="result-practice-name">your practice.</em>
        </h1>
        <p>A first look at an Otto shaped around your choices.</p>
        <div class="result-tags">
          <span id="result-size">Solo practice</span>
          <span id="result-setting">In person and online</span>
        </div>
      </section>
      <section class="result-workspace" aria-label="Your practice concept">
        <div class="result-sidebar">
          <img src="/assets/otto-logo.svg" alt="Otto" width="65" height="34" />
          <span class="result-sidebar-label">YOUR WORKSPACE</span>
          <b>◷ &nbsp; My day</b>
          <span>▤ &nbsp; My notes</span>
          <span>☷ &nbsp; Front desk</span>
          <div class="result-sidebar-bottom">
            Made for your practice.
            <br />
            <small>Illustrative concept</small>
          </div>
        </div>
        <div class="result-main">
          <div class="result-heading">
            <div>
              <span class="tag">YOUR NEXT CHAPTER</span>
              <h2>Make room for your day.</h2>
            </div>
            <span class="concept-tag">Preview</span>
          </div>
          <p class="result-explainer">
            Here are the ideas you chose. Open one to tell us whether you would
            use it.
          </p>
          <div class="result-feature-cards">
            {features.map((feature) => (
              <article data-result-feature={feature.slug}>
                <span class="result-card-number">
                  {feature.number} / YOUR PRACTICE
                </span>
                <h3>{feature.label}</h3>
                <p>{feature.description}</p>
                <button
                  type="button"
                  class="text-link"
                  data-interest={feature.slug}
                >
                  Try this idea <span aria-hidden="true">↗</span>
                </button>
              </article>
            ))}
          </div>
        </div>
      </section>
      <section class="result-next">
        <div>
          <h2>Which idea would you try first?</h2>
          <p>Open a feature above to preview the early-access flow.</p>
        </div>
        <a class="text-link" href="/your-practice/">
          Explore all three ideas ↗
        </a>
      </section>
      <p class="practice-disclosure">
        This is a concept preview. Features and availability are not confirmed.
        No appointments, clinical information, or leads are collected.
      </p>
      <dialog id="interest-dialog" aria-labelledby="interest-title">
        <button class="dialog-close" type="button" aria-label="Close">
          ×
        </button>
        <div id="interest-form-step">
          <div class="eyebrow">Help shape Otto</div>
          <h2 id="interest-title">This idea is still taking shape.</h2>
          <p>
            <strong id="interest-feature-name">
              Your practice, personalized
            </strong>{" "}
            is an early concept. Let us know if you would want to try it.
          </p>
          <form id="interest-form">
            <label for="interest-email">Demo email</label>
            <input
              type="email"
              id="interest-email"
              value="alex@example.com"
              required
              maxlength="254"
              autocomplete="off"
            />
            <button class="button" type="submit">
              Preview early-access signup ↗
            </button>
          </form>
          <p class="practice-fine">
            Demo only. Nothing is submitted or saved, and no email will be sent.
          </p>
        </div>
        <div id="interest-complete" hidden>
          <div class="eyebrow">Preview complete</div>
          <h2 tabindex="-1" id="interest-complete-title">
            Thanks for exploring.
          </h2>
          <p>
            You’ve reached the end of the early-access demo. Nothing was
            submitted or saved.
          </p>
          <button class="button" type="button" id="interest-return">
            Back to my practice ↗
          </button>
        </div>
      </dialog>
    </div>
  </main>
  <script is:inline defer src="/assets/practice.js"></script>
</SiteLayout>
