---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PracticeFeatureScene from "../../components/PracticeFeatureScene.astro";
import { features } from "../../data/practice";
import pages from "../../data/pages.json";
---

<SiteLayout metadata={pages["/your-practice/"]}>
  <link rel="stylesheet" href="/assets/practice.css" />
  <main id="main" class="practice-page practice-teaser">
    <div class="wrap">
      <section class="teaser-hero teaser-hero-film">
        <div class="teaser-hero-copy">
          <div class="eyebrow">For independent mental health practices</div>
          <h1>
            Give your patient
            <br />
            <em>your full attention.</em>
          </h1>
          <p>
            Otto turns the conversation into a note draft, proposes chart updates
            after you sign, and connects the visit to cash billing. You review
            the work and decide what’s ready, with the context for your next
            session close at hand.
          </p>
          <div class="teaser-actions">
            <a class="button" href="/your-practice/build/">
              See Otto for my practice <span aria-hidden="true">↗</span>
            </a>
            <a class="teaser-watch" href="#watch" data-play-overview>
              Watch how it works <span aria-hidden="true">↘</span>
            </a>
          </div>
        </div>
        <div class="teaser-film" id="watch">
          <video
            id="hero-overview"
            controls
            playsinline
            preload="none"
            poster="/media/otto-overview-poster.jpg"
            aria-label="Watch the Otto overview"
          >
            <source src="/media/otto-it-just-works.mp4" type="video/mp4" />
            <p>
              Your browser does not support this video.{" "}
              <a href="/media/otto-it-just-works.mp4">
                Open the Otto overview.
              </a>
            </p>
          </video>
          <button
            class="teaser-film-play"
            type="button"
            aria-label="Play the Otto overview"
            hidden
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m8 5 11 7-11 7Z" fill="currentColor" />
            </svg>
          </button>
        </div>
        <p class="teaser-film-status" role="status" aria-live="polite"></p>
        <div class="teaser-workflows" aria-label="Connected Otto workflows">
          <span>Session prep</span>
          <i aria-hidden="true"></i>
          <span>AI progress notes</span>
          <i aria-hidden="true"></i>
          <span>Telehealth</span>
          <i aria-hidden="true"></i>
          <span>Payments</span>
        </div>
      </section>
      <section id="possibilities" class="practice-possibilities">
        <div class="practice-section-head">
          <div>
            <div class="eyebrow">One connected practice day</div>
            <h2>
              Your visit moves
              <br />
              the work forward.
            </h2>
          </div>
          <p>
            The details of a visit carry into the work that follows. See how
            Otto prepares the next step for you to review.
          </p>
        </div>
        <div class="practice-cards">
          {features.map((feature) => (
            <a class="practice-card" href={`/your-practice/${feature.slug}/`}>
              <div class="pc-top">
                <span>
                  {feature.number} / {feature.short}
                </span>
              </div>
              <PracticeFeatureScene feature={feature.slug} />
              <h3>{feature.label}</h3>
              <p>{feature.description}</p>
              <span class="text-link">See how it works</span>
            </a>
          ))}
        </div>
      </section>
      <section class="teaser-care">
        <div class="eyebrow">A different way to run your practice</div>
        <h2>
          Start with work
          <br />
          <em>Otto has already prepared.</em>
        </h2>
        <p>
          With patient consent, Otto uses the session audio to draft your note.
          Once you’ve edited and signed it, Otto proposes updates for the
          chart. You confirm what belongs and dismiss what doesn’t. The
          software carries information forward while you keep the clinical
          decisions.
        </p>
        <a class="text-link" href="/your-practice/notes/">
          Take a closer look at AI notes ↗
        </a>
      </section>
      <section class="practice-close">
        <div class="eyebrow">Your practice, with Otto</div>
        <h2>
          See what a day
          <br />with Otto could feel like.
        </h2>
        <p>
          Start with the work that follows you home: notes to finish, details
          to carry into the chart, or a visit waiting for payment. Explore
          how those steps connect in Otto.
        </p>
        <a class="button light" href="/your-practice/build/">
          See Otto for my practice <span aria-hidden="true">↗</span>
        </a>
        <span class="teaser-close-note">
          Early focus: solo, self-pay mental health care. This signup preview
          does not create an account or a waitlist spot.
          <a href="/faq/#getting-started">Read about access and setup.</a>
        </span>
      </section>
      <p class="practice-disclosure">
        Product tour preview. The video shows a product demonstration. Signup is
        demo-only; no information is submitted or saved.
      </p>
    </div>
  </main>
  <script>
    const video = document.querySelector<HTMLVideoElement>("#hero-overview");
    const button =
      document.querySelector<HTMLButtonElement>(".teaser-film-play");
    const status = document.querySelector<HTMLElement>(".teaser-film-status");
    if (video && button && status) {
      video.controls = false;
      button.hidden = false;
      const play = async () => {
        status.textContent = "";
        video.controls = true;
        button.hidden = true;
        try {
          await video.play();
        } catch {
          button.hidden = false;
          status.textContent =
            "Playback could not start. Try the play button or use the video controls.";
        }
      };
      button.addEventListener("click", () => {
        video.focus();
        void play();
      });
      document
        .querySelector("[data-play-overview]")
        ?.addEventListener("click", () => {
          video.focus({ preventScroll: true });
          void play();
        });
      video.addEventListener("play", () => {
        button.hidden = true;
        video.controls = true;
      });
      video.addEventListener("ended", () => {
        button.hidden = false;
      });
    }
  </script>
</SiteLayout>
