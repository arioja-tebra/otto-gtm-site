---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PracticeVideos from "../../components/PracticeVideos.astro";
import { features } from "../../data/practice";
import pages from "../../data/pages.json";
---

<SiteLayout metadata={pages["/your-practice/"]}>
  <link rel="stylesheet" href="/assets/practice.css" />
  <main id="main" class="practice-page practice-teaser">
    <div class="wrap">
      <div class="practice-subnav">
        <span>OTTO BY TEBRA</span>
        <span class="concept-tag">For independent mental health practices</span>
      </div>
      <section class="teaser-hero">
        <div class="eyebrow">Your practice has a lot to do. Meet Otto.</div>
        <h1>
          See what Otto
          <br />
          can do <em>for you.</em>
        </h1>
        <p>
          You’re there for your patients. Otto connects the work around every
          visit, from session prep and clinical notes to telehealth and
          payments.
        </p>
        <div class="teaser-actions">
          <a class="button" href="/your-practice/build/">
            See Otto for my practice <span aria-hidden="true">↗</span>
          </a>
          <a class="teaser-watch" href="#watch">
            <span aria-hidden="true">▶</span> Watch Otto in action
          </a>
        </div>
        <div class="teaser-proof">
          <span>Built for mental health</span>
          <span>Your clinical judgment stays central</span>
          <span>Built by Tebra</span>
        </div>
        <div class="teaser-orbit" aria-hidden="true"></div>
      </section>
      <PracticeVideos />
      <div class="practice-bridge">
        <span>More room for care.</span>
        <p>Before the session. After the conversation. Through to payment.</p>
      </div>
      <section id="possibilities" class="practice-possibilities">
        <div class="practice-section-head">
          <div>
            <div class="eyebrow">One connected practice day</div>
            <h2>
              The conversation is yours.
              <br />
              Let Otto help with what comes next.
            </h2>
          </div>
          <p>
            Explore the work Otto can help you move forward, one visit at a
            time.
          </p>
        </div>
        <div class="practice-cards">
          {features.map((feature) => (
            <a class="practice-card" href={`/your-practice/${feature.slug}/`}>
              <div class="pc-top">
                <span>
                  {feature.number} / {feature.short}
                </span>
                <span aria-hidden="true">↗</span>
              </div>
              <div class={`pc-art pc-art-${feature.slug}`} aria-hidden="true">
                {feature.slug === "personalized" ? (
                  <>
                    <i></i>
                    <i></i>
                    <i></i>
                    <b>Be ready.</b>
                  </>
                ) : feature.slug === "notes" ? (
                  <>
                    <b>SOAP / DAP</b>
                    <i></i>
                    <i></i>
                    <i></i>
                  </>
                ) : (
                  <>
                    <b>Keep it moving.</b>
                    <i>Visit</i>
                    <i>Billing</i>
                    <i>Payment</i>
                  </>
                )}
              </div>
              <h3>{feature.label}</h3>
              <p>{feature.description}</p>
              <span class="text-link">
                See how it works <span aria-hidden="true">↗</span>
              </span>
            </a>
          ))}
        </div>
      </section>
      <section class="teaser-care">
        <div class="eyebrow">You stay in charge of the care</div>
        <h2>
          Otto starts the draft.
          <br />
          <em>You make the clinical decisions.</em>
        </h2>
        <p>
          Review the note. Make your edits. Approve what belongs in the chart.
          Your judgment stays at the center of every visit.
        </p>
        <a class="text-link" href="/your-practice/notes/">
          Take a closer look at AI notes ↗
        </a>
      </section>
      <section class="practice-close">
        <div class="eyebrow">Your practice, with Otto</div>
        <h2>
          What would you like
          <br />a hand with first?
        </h2>
        <p>
          Tell us a little about your practice. Explore the parts of Otto that
          matter to your day.
        </p>
        <a class="button light" href="/your-practice/build/">
          See Otto for my practice <span aria-hidden="true">↗</span>
        </a>
        <span class="teaser-close-note">
          A short, interactive product tour.
        </span>
      </section>
      <p class="practice-disclosure">
        Product tour preview. Videos show product demonstrations. Signup is
        demo-only; no information is submitted or saved.
      </p>
    </div>
  </main>
</SiteLayout>
