---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PracticeVisual from "../../components/PracticeVisual.astro";
import { features } from "../../data/practice";
import pages from "../../data/pages.json";
---

<SiteLayout metadata={pages["/your-practice/"]}>
  <link rel="stylesheet" href="/assets/practice.css" />
  <main id="main" class="practice-page">
    <div class="wrap">
      <div class="practice-subnav">
        <span>THE NEXT CHAPTER OF OTTO</span>
        <span class="concept-tag">An early look</span>
      </div>
      <section class="practice-hero">
        <div class="practice-intro">
          <div class="eyebrow">Built around you</div>
          <h1>
            Your practice,
            <br />
            <em>personalized.</em>
          </h1>
          <p>
            You bring your own way of caring. Help shape an Otto that fits the
            way you work, from your first appointment to your last note.
          </p>
          <a class="button" href="/your-practice/build/">
            Make it yours <span aria-hidden="true">↗</span>
          </a>
          <a class="practice-secondary" href="#possibilities">
            Explore the possibilities ↓
          </a>
          <div class="practice-fine">
            About a minute. Preview with fictional details.
          </div>
        </div>
        <PracticeVisual />
      </section>
      <div class="practice-bridge">
        <span>A practice is personal.</span>
        <p>So are the details that make a workday feel right.</p>
      </div>
      <section id="possibilities" class="practice-possibilities">
        <div class="practice-section-head">
          <div>
            <div class="eyebrow">A few things we’re exploring</div>
            <h2>What would make Otto yours?</h2>
          </div>
          <p>
            Take a closer look, then choose what belongs in your practice
            preview.
          </p>
        </div>
        <div class="practice-cards">
          {features.map((feature) => (
            <a class="practice-card" href={`/your-practice/${feature.slug}/`}>
              <div class="pc-top">
                <span>{feature.number}</span>
                <span aria-hidden="true">↗</span>
              </div>
              <div class={`pc-art pc-art-${feature.slug}`} aria-hidden="true">
                {feature.slug === "personalized" ? (
                  <>
                    <i></i>
                    <i></i>
                    <i></i>
                    <b>Yours.</b>
                  </>
                ) : feature.slug === "notes" ? (
                  <>
                    <b>DAP</b>
                    <i></i>
                    <i></i>
                    <i></i>
                  </>
                ) : (
                  <>
                    <b>Good morning.</b>
                    <i>Appointments</i>
                    <i>Intake</i>
                    <i>Follow-ups</i>
                  </>
                )}
              </div>
              <h3>{feature.label}</h3>
              <p>{feature.description}</p>
              <span class="text-link">
                Explore this idea <span aria-hidden="true">↗</span>
              </span>
            </a>
          ))}
        </div>
      </section>
      <section class="practice-close">
        <div class="eyebrow">Start with your practice</div>
        <h2>See what your version could look like.</h2>
        <p>Choose your setup and the ideas you would use most.</p>
        <a class="button light" href="/your-practice/build/">
          Build my practice preview ↗
        </a>
      </section>
      <p class="practice-disclosure">
        These are early concepts for feedback. Features and availability are not
        confirmed. This preview does not collect or save information.
      </p>
    </div>
  </main>
</SiteLayout>
