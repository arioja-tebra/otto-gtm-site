                        width="285"
                        height="340"
                        rx="8"
                        fill="#e8e5df"
                      />
                      <rect width="285" height="340" rx="8" fill="#f6f3eb" />
                      <text
                        x="28"
                        y="55"
                        font-size="26"
                        fill="#004852"
