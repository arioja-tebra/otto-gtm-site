    <section class="cta-section">
      <div class="wrap">
        <div class="cta">
          <div>
            <h2>Start with one visit.</h2>
            <p>
              Watch Otto prepare a note draft, then follow the clinician’s review
              and payment steps. You can watch without signing up.
            </p>
          </div>
          <a class="button light" href="/demo/#watch">
            Watch the demo <span aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .access-copy { max-width: 760px; margin: 16px 0 0; }
  .access-copy a { text-decoration: underline; }

  .editorial-home {
    background: var(--paper);
    font-size: 16px;
    line-height: 22px;
  }

  .editorial-home > .wrap {
    max-width: none;
    padding: 0;
  }

  [data-b5-content],
  .cta-section > .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 56px);
  }

  .product-hero {
    display: block;
    /* Card edge follows the 1200px content column below. */
    padding: 126px clamp(20px, 4vw, 56px) 56px calc(max(0px, (100% - 1200px) / 2) + clamp(20px, 4vw, 56px));
    background: #d9cfc3 url("/media/hero-photo.png") 70% 14% / cover;
  }

  .product-hero > div:first-child {
    max-width: 540px;
    padding: 40px 44px;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 70px 55px -20px rgba(0, 0, 0, 0.04);
  }

  .product-hero > .art {
    display: none;
  }

  .eyebrow {
    display: block;
    margin-bottom: 14px;
    color: var(--ink-secondary);
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    letter-spacing: 1.44px;
  }

  .eyebrow::before {
    display: none;
  }

  .product-hero h1 {
    margin: 0;
    font-size: clamp(40px, 4.4vw, 60px);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -1.4px;
    text-wrap: balance;
  }

  .product-hero p {
    margin: 16px 0 24px;
    font-size: 18px;
    line-height: 28px;
    text-wrap: pretty;
  }

  .product-hero .button {
    min-height: 46px;
    padding: 0 24px;
    font-weight: 500;
  }

  .product-section,
  .cta-section {
    padding: 64px 0;
  }

  .product-section:nth-child(2),
  .cta-section {
    background: var(--white);
  }

  .product-section:nth-child(3) {
    background: rgba(65, 126, 134, 0.22);
  }

  .product-section h2,
  .cta h2 {
    margin: 0;
    font-size: clamp(30px, 3vw, 42px);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.8px;
    text-wrap: balance;
  }

  .section-head {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px 32px;
    margin-bottom: 24px;
  }

  .section-head h2 {
    max-width: 760px;
    letter-spacing: -1px;
  }

  .text-link {
    padding: 0;
    line-height: 22px;
  }

  .tool-grid,
  .article-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
    gap: 16px;
  }

  .tool-card {
    overflow: hidden;
    padding: 0;
    color: var(--ink);
  }

  .tool-icon {
    position: relative;
    width: 100%;
    height: 176px;
    flex: none;
    overflow: hidden;
    margin: 0;
    border: 0;
    border-radius: 0;
    background: #f0eee8;
  }

  .tool-icon svg {
    display: none;
  }

  .tool-icon::before {
    content: "";
    position: absolute;
    top: 20px;
    left: calc(50% - 81px);
    width: 162px;
    height: 220px;
    border: 1px solid #e8e5df;
    border-radius: 10px;
    background:
      linear-gradient(var(--secondary), var(--secondary)) 14px 48px / 90px 5px
        no-repeat,
