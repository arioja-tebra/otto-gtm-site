                    <path d="M141 390v-85" stroke="#004852" stroke-width="3" />
                    <path
                      d="M141 343c-55-2-55-44-55-44 47 1 55 44 55 44m0-18c48-2 55-48 55-48-45 0-55 48-55 48"
                      fill="#417e86"
                    />
                    <path d="M110 368h62l-10 49h-43z" fill="#f6f3eb" />
                  </svg>
                </div>
                <div data-b5-story-copy>
                  <span class="tag">Practice finances</span>
                  <h3>How much should you charge for therapy?</h3>
                  <p>
                    Build a session rate around your income, expenses, and the
                    week you actually want to work.
                  </p>
                  <div class="card-meta">
                    <span>Otto editorial</span>
                    <span>6 min read </span>
                  </div>
                </div>
              </a>
            </article>
            <article
              class="story-card"
              data-story
              data-category="Billing & paperwork"
            >
              <a href="/blog/superbill-for-therapy/">
                <div class="art">
                  <svg
                    viewBox="0 0 640 500"
                    preserveAspectRatio="xMidYMid slice"
                    aria-hidden="true"
                  >
                    <rect width="640" height="500" fill="#cbdde0" />
                    <circle cx="535" cy="55" r="180" fill="#b3c6c4" />
                    <path d="M0 390 640 250v250H0z" fill="#8ca7a2" />
                    <g transform="translate(171 55) rotate(-9 140 170)">
                      <rect
