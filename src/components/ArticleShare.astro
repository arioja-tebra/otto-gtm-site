---
interface Props {
  title: string;
}
const { title } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
---

<section
  class="article-share"
  aria-label="Share this article"
  data-article-share
>
  <p class="article-share-label">Share this article</p>
  <div class="article-share-links">
    <button type="button" data-share-copy>
      Copy link
    </button>
    <a
      data-share-linkedin
      href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      LinkedIn<span class="sr-only"> (opens in a new tab)</span>
    </a>
    <a
      data-share-facebook
      href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      Facebook<span class="sr-only"> (opens in a new tab)</span>
    </a>
    <a
      data-share-email
      href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(url)}`}
    >
      Email
    </a>
  </div>
  <p class="article-share-status" role="status" aria-live="polite"></p>
</section>

<style>
  .article-share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    font-family: var(--component-text-family-body);
    font-size: 14px;
    line-height: 20px;
  }

  .article-share .article-share-label {
    margin: 0;
    color: var(--ink-secondary);
    font-weight: 400;
  }

  .article-share-links {
    max-width: 100%;
  }

  .article-share-links a,
  .article-share-links button {
    background: var(--white);
    border-color: var(--primitive-brand-backbone-3);
    color: var(--deep-teal);
  }

  .article-share-links a:hover,
  .article-share-links button:hover {
    background: var(--vitality-1);
    border-color: var(--vitality-1);
  }

  .article-share :global(:focus-visible) {
    outline: 2px solid var(--growth-2);
    outline-offset: 3px;
  }

  .article-share .article-share-status {
    flex-basis: 100%;
    min-height: 0;
    margin: 0;
    color: var(--ink);
    font-size: 14px;
  }

  .article-share-status:empty {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .article-share-status :global(input) {
    min-height: 44px;
    border: 1px solid var(--growth-2);
    border-radius: 8px;
    background: var(--white);
    color: var(--ink);
  }
</style>
